[core]
  pager = delta

[delta]
  navigate = true
  syntax-theme = zenburn
  dark = true

[diff]
  colorMoved = default

[init]
  defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictstyle = diff3

[pull]
  rebase = true

[fetch]
  prune = true

[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f

