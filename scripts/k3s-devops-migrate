#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
forgejo_source="/var/lib/forgejo"
forgejo_target="/var/lib/kosmos-k3s/forgejo"
woodpecker_source="/var/lib/private/woodpecker-server"
woodpecker_target="/var/lib/kosmos-k3s/woodpecker"
woodpecker_secret="/run/agenix/woodpecker-server-env"
cutover_marker="/var/lib/kosmos-k3s/cutover-complete"

if [[ ${EUID} -ne 0 ]]; then
  echo "run this command as root" >&2
  exit 1
fi

legacy_units=(
  forgejo.service
  forgejo-internal-registry-proxy.service
  woodpecker-server.service
  woodpecker-agent-wsl-podman.service
  woodpecker-agent-wsl-podman-2.service
  woodpecker-agent-wsl-podman-3.service
  podman-dagger-engine.service
  cloudflared-tunnel-kepos.service
)

stop_known_units() {
  local unit
  for unit in "${legacy_units[@]}"; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      systemctl stop "$unit"
    fi
  done
}

start_known_units() {
  local unit
  for unit in "${legacy_units[@]}"; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      systemctl start "$unit"
    fi
  done
}

case "$mode" in
  prepare)
    if [[ -e "$cutover_marker" ]]; then
      echo "cutover is already complete; rollback before preparing another migration" >&2
      exit 1
    fi
    for path in "$forgejo_source" "$woodpecker_source" "$woodpecker_secret" "$kubeconfig"; do
      [[ -e "$path" ]] || {
        printf 'required migration input is missing: %s\n' "$path" >&2
        exit 1
      }
    done
    command -v rsync >/dev/null
    command -v sqlite3 >/dev/null
    command -v kubectl >/dev/null

    stop_known_units
    restore_legacy=true
    trap 'if [[ "$restore_legacy" == true ]]; then start_known_units; fi' EXIT

    KUBECONFIG="$kubeconfig" kubectl create namespace devops \
      --dry-run=client \
      --output=yaml \
      | KUBECONFIG="$kubeconfig" kubectl apply -f - >/dev/null

    install -d -m 0750 "$forgejo_target" "$woodpecker_target"
    rsync --archive --delete "$forgejo_source/" "$forgejo_target/"
    rsync --archive --delete "$woodpecker_source/" "$woodpecker_target/"
    forgejo_db="$forgejo_target/data/forgejo.db"
    sqlite3 "$forgejo_db" 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null
    oauth_rows="$(sqlite3 "$forgejo_db" \
      "UPDATE oauth2_application SET redirect_uris='[\"http://woodpecker.localhost:17480/authorize\"]', updated_unix=strftime('%s','now') WHERE name='Woodpecker WSL'; SELECT changes();")"
    [[ "$oauth_rows" == "1" ]] || {
      echo "expected exactly one Woodpecker WSL OAuth application in the copied Forgejo database" >&2
      exit 1
    }
    chown -R 1000:1000 "$forgejo_target" "$woodpecker_target"
    chmod 0600 "$forgejo_target/custom/conf/app.ini"

    KUBECONFIG="$kubeconfig" kubectl create secret generic woodpecker-server-env \
      --namespace devops \
      --from-env-file="$woodpecker_secret" \
      --dry-run=client \
      --output=yaml \
      | KUBECONFIG="$kubeconfig" kubectl apply -f - >/dev/null

    restore_legacy=false
    trap - EXIT
    echo "data snapshot and Kubernetes secret are ready; legacy services remain stopped"
    ;;
  complete)
    install -m 0644 /dev/null "$cutover_marker"
    echo "cutover marked complete; legacy services will stay disabled after reboot"
    ;;
  rollback)
    KUBECONFIG="$kubeconfig" kubectl delete \
      deployment/canonical-gateway \
      deployment/forgejo \
      deployment/woodpecker \
      statefulset/woodpecker-agent \
      daemonset/dagger \
      --namespace devops --ignore-not-found --wait=true >/dev/null
    sqlite3 "$forgejo_target/data/forgejo.db" 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null
    rsync --archive --delete "$forgejo_target/" "$forgejo_source/"
    rsync --archive --delete "$woodpecker_target/" "$woodpecker_source/"
    sqlite3 "$forgejo_source/data/forgejo.db" \
      "UPDATE oauth2_application SET redirect_uris='[\"https://ci.guion.io/authorize\"]', updated_unix=strftime('%s','now') WHERE name='Woodpecker WSL';" >/dev/null
    chown -R forgejo:forgejo "$forgejo_source"
    chown -R nobody:nogroup "$woodpecker_source"
    chmod 0440 "$forgejo_source/custom/conf/app.ini"
    if [[ -e "$cutover_marker" ]]; then
      unlink "$cutover_marker"
    fi
    start_known_units
    echo "k3s workloads stopped and legacy services restarted"
    ;;
  *)
    echo "usage: k3s-devops-migrate prepare|complete|rollback" >&2
    exit 2
    ;;
esac
