#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"
if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo "usage: sync-cloudreve-secret [--validate-only] ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == "-" ]]; then
  env_file=/dev/stdin
elif [[ ! -s "$env_file" ]]; then
  printf 'missing or empty Cloudreve environment file: %s\n' "$env_file" >&2
  exit 1
fi

line_count=0
postgres_password=""
session_secret=""
while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  if [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]]; then
    continue
  fi

  line_count=$((line_count + 1))
  case "$key" in
    POSTGRES_PASSWORD)
      if [[ -n "$postgres_password" ]]; then
        echo 'Cloudreve environment contains a duplicate POSTGRES_PASSWORD' >&2
        exit 1
      fi
      postgres_password="$value"
      ;;
    SESSION_SECRET)
      if [[ -n "$session_secret" ]]; then
        echo 'Cloudreve environment contains a duplicate SESSION_SECRET' >&2
        exit 1
      fi
      session_secret="$value"
      ;;
    *)
      echo 'Cloudreve environment contains an unexpected entry' >&2
      exit 1
      ;;
  esac
done <"$env_file"

if [[ "$line_count" -ne 2 || ! "$postgres_password" =~ ^[0-9a-f]{64}$ || ! "$session_secret" =~ ^[0-9a-f]{128}$ ]]; then
  echo 'Cloudreve environment must contain one 64-character POSTGRES_PASSWORD and one 128-character SESSION_SECRET' >&2
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo 'Cloudreve environment validation passed'
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

secret_dir="$(mktemp -d)"
trap 'rm -rf "$secret_dir"' EXIT
chmod 700 "$secret_dir"
umask 077
printf '%s\n' "$postgres_password" >"$secret_dir/POSTGRES_PASSWORD"
cat >"$secret_dir/conf.ini" <<EOF
[System]
Mode = master
Listen = :5212
SessionSecret = $session_secret
ProxyHeader = X-Forwarded-For

[Database]
Type = postgres
Port = 5432
User = cloudreve
Password = $postgres_password
Host = cloudreve-postgres
Name = cloudreve

[Redis]
Server = cloudreve-redis:6379
EOF

"${kubectl_local[@]}" create namespace cloudreve --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

sync_postgres_password() {
  if ! "${kubectl_local[@]}" rollout status statefulset/cloudreve-postgres --namespace cloudreve --timeout=180s; then
    echo 'Cloudreve PostgreSQL did not become ready for credential synchronization' >&2
    return 1
  fi

  if ! printf "ALTER USER cloudreve PASSWORD '%s';\n" "$postgres_password" \
    | "${kubectl_local[@]}" exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- \
      psql -v ON_ERROR_STOP=1 -U cloudreve -d cloudreve >/dev/null; then
    echo 'Cloudreve PostgreSQL password synchronization failed' >&2
    return 1
  fi
}

secret_exists=0
secret_changed=1
password_changed=1
if "${kubectl_local[@]}" get secret cloudreve-env --namespace cloudreve >/dev/null 2>&1; then
  secret_exists=1
  live_password="$("${kubectl_local[@]}" get secret cloudreve-env --namespace cloudreve -o jsonpath='{.data.POSTGRES_PASSWORD}')"
  live_config="$("${kubectl_local[@]}" get secret cloudreve-env --namespace cloudreve -o jsonpath='{.data.conf\.ini}')"
  desired_password="$(base64 -w0 "$secret_dir/POSTGRES_PASSWORD")"
  desired_config="$(base64 -w0 "$secret_dir/conf.ini")"
  if [[ "$live_password" == "$desired_password" && "$live_config" == "$desired_config" ]]; then
    secret_changed=0
    password_changed=0
  elif [[ "$live_password" == "$desired_password" ]]; then
    password_changed=0
  fi
fi

postgres_exists=0
if "${kubectl_local[@]}" get statefulset/cloudreve-postgres --namespace cloudreve >/dev/null 2>&1; then
  postgres_exists=1
fi

# Rotate an existing PostgreSQL role before publishing its new application
# configuration. If this step fails, the old Kubernetes Secret remains in
# place, so systemd's retry still recognizes the pending password change.
postgres_password_synchronized=0
if [[ "$secret_exists" -eq 1 && "$password_changed" -eq 1 && "$postgres_exists" -eq 1 ]]; then
  sync_postgres_password
  postgres_password_synchronized=1
fi

if [[ "$secret_changed" -eq 1 ]]; then
  "${kubectl_local[@]}" create secret generic cloudreve-env \
    --namespace cloudreve \
    --from-file=POSTGRES_PASSWORD="$secret_dir/POSTGRES_PASSWORD" \
    --from-file=conf.ini="$secret_dir/conf.ini" \
    --dry-run=client \
    -o yaml >"$secret_dir/secret.yaml"
  "${kubectl_local[@]}" apply -f "$secret_dir/secret.yaml" >/dev/null
fi

if "${kubectl_local[@]}" get deployment/cloudreve --namespace cloudreve >/dev/null 2>&1; then
  secret_version="$("${kubectl_local[@]}" get secret cloudreve-env --namespace cloudreve -o jsonpath='{.metadata.resourceVersion}')"
  if [[ -z "$secret_version" ]]; then
    echo 'Cloudreve Secret has no resourceVersion' >&2
    exit 1
  fi

  deployment_secret_version="$("${kubectl_local[@]}" get deployment/cloudreve --namespace cloudreve -o jsonpath='{.spec.template.metadata.annotations.kosmos\.tta-lab\.org/cloudreve-secret-version}')"
  deployment_needs_sync=0
  if [[ "$deployment_secret_version" != "$secret_version" ]]; then
    deployment_needs_sync=1
  fi

  # An interrupted synchronization can publish the Secret before its database
  # and application steps finish. The stale deployment marker is the durable
  # recovery signal for the next systemd retry.
  if [[ "$deployment_needs_sync" -eq 1 && "$postgres_exists" -eq 1 && "$postgres_password_synchronized" -eq 0 ]]; then
    sync_postgres_password
    postgres_password_synchronized=1
  fi

  if [[ "$deployment_needs_sync" -eq 1 ]]; then
    printf -v deployment_patch '{"spec":{"template":{"metadata":{"annotations":{"kosmos.tta-lab.org/cloudreve-secret-version":"%s"}}}}}' "$secret_version"
    "${kubectl_local[@]}" patch deployment/cloudreve \
      --namespace cloudreve \
      --type=merge \
      --patch "$deployment_patch" \
      >/dev/null
  fi

  # If a prior attempt patched the template but timed out waiting for Pods,
  # keep the systemd retry active until that rollout is actually healthy.
  if ! "${kubectl_local[@]}" rollout status deployment/cloudreve --namespace cloudreve --timeout=300s; then
    echo 'Cloudreve rollout did not complete after Secret synchronization' >&2
    exit 1
  fi
fi

echo 'Cloudreve Secret synchronized to local K3s'
