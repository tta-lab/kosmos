#!/usr/bin/env bash
# OpenClaw gateway wrapper (official install, --wrapper mode).
# Injects agenix-decrypted secrets from ~/.config/openclaw/* (symlinks into
# /run/agenix) into the gateway environment without persisting plaintext.
# Then execs the real openclaw gateway with the original args.
set -euo pipefail

read_secret() {
  local file="$1" var="$2"
  if [ -f "$file" ]; then
    local raw
    raw="$(cat "$file")"
    raw="${raw%$'\n'}"
    export "$var=$raw"
  fi
}

# Provider / channel / gateway secrets (agenix targets, plaintext never
# written to disk outside /run/agenix).
read_secret /home/neil/.config/openclaw/deepseek-key DEEPSEEK_API_KEY
read_secret /home/neil/.config/openclaw/soniox-key SONIOX_API_KEY
read_secret /home/neil/.config/openclaw/volcengine-key VOLCENGINE_TTS_API_KEY
read_secret /home/neil/.config/openclaw/telegram-token TELEGRAM_BOT_TOKEN
read_secret /home/neil/.config/openclaw/gateway-token OPENCLAW_GATEWAY_TOKEN

# MCP commands (web/og/project/src/miniflux-mcp) live in ~/go/bin, which the
# gateway unit PATH does not include.
export PATH="$PATH:/home/neil/go/bin"

# Source the non-secret, Nix-generated canonical proxy variables. The gateway
# is self-managed, so this interface is mandatory after the WSL configuration
# has been activated.
# shellcheck disable=SC1091
source /etc/kosmos/proxy.env

# Local k3s services bypass Mihomo because it cannot resolve *.localhost.
export NO_PROXY="${NO_PROXY},*.localhost"
export no_proxy="${no_proxy},*.localhost"

# The canonical K3s gateway listens on IPv4 loopback; Node otherwise tries ::1
# first for *.localhost, which makes Hindsight's external API health check fail.
export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--dns-result-order=ipv4first"

exec /home/neil/.local/share/npm-global/bin/openclaw "$@"
