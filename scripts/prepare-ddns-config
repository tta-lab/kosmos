#!/usr/bin/env python3
"""Render ddns-go's runtime configuration from a systemd credential."""

import json
import os
import pathlib
import sys


def main():
    token_file, address_command, output_file = sys.argv[1:]
    token = pathlib.Path(token_file).read_text().strip()
    if not token or any(character.isspace() for character in token):
        raise SystemExit("Cloudflare token is empty or contains whitespace")
    configuration = {
        "dnsconf": [{
            "name": "Kosmos public IPv6",
            "ipv4": {"enable": False},
            "ipv6": {
                "enable": True,
                "gettype": "cmd",
                "cmd": address_command,
                "domains": ["ddns-smoke.guion.io?proxied=false"],
            },
            "dns": {"name": "cloudflare", "id": "", "secret": token},
            "ttl": "300",
        }],
        "notallowwanaccess": True,
    }
    descriptor = os.open(output_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as output:
        os.fchmod(output.fileno(), 0o600)
        json.dump(configuration, output)


if __name__ == "__main__":
    main()
