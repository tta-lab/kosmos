#!/usr/bin/env bash
# Read-only ExecCondition: status 1 skips startup without a restart loop.
set -euo pipefail
app=$1
if [[ "$app" != /* ]]; then
  echo 'Post application root must be absolute.' >&2
  exit 1
fi
for entry in package.json pnpm-lock.yaml pnpm-workspace.yaml koishi.yml dist/cli.cjs post/package.json post/dist/post-plugin.cjs; do
  if [[ ! -r "$app/$entry" ]]; then
    echo 'Post application uninitialized: install the reviewed complete seed once into the private writable app root before starting lamplit-post-console.' >&2
    exit 1
  fi
done
if [[ ! -d "$app/node_modules" || ! -d "$app/patches" || ! -w "$app" ]]; then
  echo 'Post application uninitialized or not writable: operator installation required.' >&2
  exit 1
fi
