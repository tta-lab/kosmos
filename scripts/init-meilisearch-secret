#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace meilisearch --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

if "${kubectl_local[@]}" get secret meilisearch-master-key --namespace meilisearch >/dev/null 2>&1; then
  echo 'Kept existing Meilisearch master key'
  exit 0
fi

secret_dir="$(mktemp -d)"
trap 'rm -rf "$secret_dir"' EXIT
chmod 700 "$secret_dir"

umask 077
openssl rand -hex 32 | tr -d '\n' >"$secret_dir/master-key"
chmod 600 "$secret_dir/master-key"

"${kubectl_local[@]}" create secret generic meilisearch-master-key \
  --namespace meilisearch \
  --from-file=MEILI_MASTER_KEY="$secret_dir/master-key" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

echo 'Created Meilisearch master key'
