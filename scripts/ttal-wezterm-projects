#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: ttal-wezterm-projects --choices
EOF
}

mode=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --choices)
      mode="choices"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

if [[ "$mode" != "choices" ]]; then
  usage
  exit 2
fi

project_json="${TTAL_WEZTERM_PROJECTS_JSON:-}"
if [[ -z "$project_json" ]]; then
  project_json="$(ttal project list --json)"
fi

choices_json="$(
  jq -c '.[] | select(.alias and .path)' <<<"$project_json" | while IFS= read -r project; do
    alias="$(jq -r '.alias' <<<"$project")"
    name="$(jq -r '.name // ""' <<<"$project")"
    path="$(jq -r '.path' <<<"$project")"

    if [[ -z "$alias" || "$alias" == *$'\t'* || "$alias" == *$'\r'* || "$alias" == *$'\n'* ]]; then
      continue
    fi

    if [[ ! -d "$path" ]]; then
      continue
    fi

    jq -n \
      --arg alias "$alias" \
      --arg name "$name" \
      --arg path "$path" \
      '{
        id: ($alias + "\t" + $path),
        label: ($alias + "  " + $name + "  " + $path)
      }'
  done | jq -s .
)"

printf '%s\n' "$choices_json"
