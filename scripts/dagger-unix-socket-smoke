#!/usr/bin/env bash
set -euo pipefail

socket="${DAGGER_SOCKET:-/run/dagger/engine.sock}"

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

require dagger
require systemctl

systemctl is-active --quiet podman-dagger-engine.service

if [[ ! -S "$socket" ]]; then
  printf 'missing Dagger Unix socket: %s\n' "$socket" >&2
  exit 1
fi

_EXPERIMENTAL_DAGGER_RUNNER_HOST="unix://${socket}" dagger version >/dev/null

printf 'Dagger Unix socket smoke passed through %s\n' "$socket"
