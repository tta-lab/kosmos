#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local path="$1"
  local directory
  local link

  case "$path" in
    */*) ;;
    *) path="$(command -v "$path")" ;;
  esac

  while [[ -L "$path" ]]; do
    directory="$(cd -P "$(dirname "$path")" && pwd)"
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$directory/$link" ;;
    esac
  done

  cd -P "$(dirname "$path")" && pwd
}

script_directory="$(resolve_script_path "$0")"
repository_root="$(cd "$script_directory/.." && pwd)"
rules_source="$repository_root/AGENTS.user.md"
skills_source="$repository_root/skills"
codex_directory="$HOME/.codex"
installed_skills_directory="$HOME/.agents/skills"

if [[ ! -f "$rules_source" || ! -d "$skills_source" ]]; then
  printf 'not a Kosmos checkout: %s\n' "$repository_root" >&2
  exit 1
fi

for directory in "$codex_directory" "$installed_skills_directory"; do
  if [[ -e "$directory" && ! -d "$directory" ]]; then
    printf 'expected directory: %s\n' "$directory" >&2
    exit 1
  fi
done

mkdir -p "$codex_directory" "$installed_skills_directory"

sources=("$rules_source")
targets=("$codex_directory/AGENTS.md")

while IFS= read -r -d '' skill; do
  name="$(basename "$skill")"
  sources+=("$skill")
  targets+=("$installed_skills_directory/$name")
done < <(find "$skills_source" -mindepth 1 -maxdepth 1 -type d -print0)

for target in "${targets[@]}"; do
  if [[ -e "$target" && ! -L "$target" ]]; then
    printf 'refusing to replace non-symlink target: %s\n' "$target" >&2
    exit 1
  fi

  if [[ -L "$target" ]] && [[ "$(readlink "$target")" == /nix/store/* ]]; then
    printf 'refusing to replace Home Manager target: %s\n' "$target" >&2
    exit 1
  fi
done

for index in "${!sources[@]}"; do
  source="${sources[$index]}"
  target="${targets[$index]}"

  if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source" ]]; then
    continue
  fi

  rm -f "$target"
  ln -s "$source" "$target"
done

printf 'linked portable agent rules and %d shared skills\n' "$((${#sources[@]} - 1))"
printf 'left host-local rules untouched: %s\n' "$codex_directory/AGENTS.machine.md"
