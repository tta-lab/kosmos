#!/usr/bin/env bash
set -euo pipefail

replace_links=false

usage() {
  printf 'usage: %s [--replace]\n' "$(basename "$0")" >&2
}

case "$#" in
  0) ;;
  1)
    if [[ "$1" == "--replace" ]]; then
      replace_links=true
    else
      usage
      exit 1
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac

resolve_script_path() {
  local path="$1"
  local directory
  local link

  case "$path" in
    */*) ;;
    *) path="$(command -v "$path")" ;;
  esac

  while [[ -L "$path" ]]; do
    directory="$(cd -P "$(dirname "$path")" && pwd)"
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$directory/$link" ;;
    esac
  done

  cd -P "$(dirname "$path")" && pwd
}

script_directory="$(resolve_script_path "$0")"
repository_root="$(cd "$script_directory/.." && pwd)"
rules_source="$repository_root/AGENTS.user.md"

if [[ ! -f "$rules_source" ]]; then
  printf 'not a Kosmos checkout: %s\n' "$repository_root" >&2
  exit 1
fi

symlink_agent_rules() {
  local target_dir="$1"
  local target="$target_dir/AGENTS.md"

  if [[ -e "$target_dir" && ! -d "$target_dir" ]]; then
    printf 'expected directory: %s\n' "$target_dir" >&2
    return 1
  fi

  mkdir -p "$target_dir"

  if [[ -e "$target" && ! -L "$target" ]]; then
    printf 'refusing to replace non-symlink target: %s\n' "$target" >&2
    return 1
  fi

  if [[ -L "$target" ]] && [[ "$(readlink "$target")" == /nix/store/* ]]; then
    printf 'skipping Home Manager target: %s\n' "$target" >&2
    return 0
  fi

  if [[ -L "$target" ]] && [[ "$(readlink "$target")" != "$rules_source" ]] && [[ "$replace_links" == false ]]; then
    printf 'refusing to replace symlink target: %s (rerun with --replace to take it over)\n' "$target" >&2
    return 1
  fi

  if [[ ! -L "$target" ]] || [[ "$(readlink "$target")" != "$rules_source" ]]; then
    rm -f "$target"
    ln -s "$rules_source" "$target"
  fi

  printf 'linked portable agent rules: %s -> %s\n' "$target" "$rules_source"
}

symlink_agent_rules "$HOME/.pi/agent"
symlink_agent_rules "$HOME/.codex"

printf 'left host-local rules untouched: %s\n' "$HOME/.codex/AGENTS.machine.md"
