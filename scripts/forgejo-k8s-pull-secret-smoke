#!/usr/bin/env bash
set -euo pipefail

source_namespace="${FORGEJO_PULL_SECRET_SOURCE_NAMESPACE:-devops}"
secret_name="${FORGEJO_PULL_SECRET_NAME:-forgejo-packages}"
target_namespaces="${FORGEJO_PULL_SECRET_TARGET_NAMESPACES:-apps-dev apps-prod apps-share}"
smoke_namespace="${FORGEJO_PULL_SECRET_SMOKE_NAMESPACE:-apps-dev}"
image="${FORGEJO_PULL_SECRET_SMOKE_IMAGE:-git.guion.io/guionai/dagger-smoke:latest}"
pod_name="${FORGEJO_PULL_SECRET_SMOKE_POD:-forgejo-packages-pull-smoke}"
timeout_seconds="${FORGEJO_PULL_SECRET_TIMEOUT_SECONDS:-90}"

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

secret_type() {
  kubectl get secret "$secret_name" -n "$1" -o jsonpath='{.type}'
}

source_annotation() {
  kubectl get secret "$secret_name" -n "$source_namespace" -o "jsonpath={.metadata.annotations.$1}" 2>/dev/null || true
}

require kubectl
require sleep

source_type="$(secret_type "$source_namespace")"
if [[ "$source_type" != "kubernetes.io/dockerconfigjson" ]]; then
  printf 'source secret %s/%s has unexpected type: %s\n' "$source_namespace" "$secret_name" "$source_type" >&2
  exit 1
fi
printf 'ok: source secret %s/%s type is kubernetes.io/dockerconfigjson\n' "$source_namespace" "$secret_name"

reflection_allowed="$(source_annotation 'reflector\.v1\.k8s\.emberstack\.com/reflection-allowed')"
reflection_auto="$(source_annotation 'reflector\.v1\.k8s\.emberstack\.com/reflection-auto-enabled')"
reflection_namespaces="$(source_annotation 'reflector\.v1\.k8s\.emberstack\.com/reflection-allowed-namespaces')"

if [[ "$reflection_allowed" != "true" || "$reflection_auto" != "true" ]]; then
  printf 'source secret %s/%s is missing Reflector auto-mirror annotations\n' "$source_namespace" "$secret_name" >&2
  exit 1
fi
printf 'ok: source secret has Reflector auto-mirror annotations\n'

for namespace in $target_namespaces; do
  if [[ " $reflection_namespaces " != *" $namespace "* && ",$reflection_namespaces," != *",$namespace,"* ]]; then
    printf 'source secret allowed namespaces do not include %s: %s\n' "$namespace" "$reflection_namespaces" >&2
    exit 1
  fi

  target_type="$(secret_type "$namespace")"
  if [[ "$target_type" != "kubernetes.io/dockerconfigjson" ]]; then
    printf 'target secret %s/%s has unexpected type: %s\n' "$namespace" "$secret_name" "$target_type" >&2
    exit 1
  fi
  printf 'ok: target secret %s/%s type is kubernetes.io/dockerconfigjson\n' "$namespace" "$secret_name"
done

kubectl delete pod "$pod_name" -n "$smoke_namespace" --ignore-not-found --wait=true >/dev/null

kubectl apply -n "$smoke_namespace" -f - >/dev/null <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: ${pod_name}
spec:
  restartPolicy: Never
  imagePullSecrets:
    - name: ${secret_name}
  containers:
    - name: smoke
      image: ${image}
      imagePullPolicy: Always
      command: ["/smoke.txt"]
EOF

deadline=$((SECONDS + timeout_seconds))
while [[ "$SECONDS" -lt "$deadline" ]]; do
  image_id="$(
    kubectl get pod "$pod_name" -n "$smoke_namespace" \
      -o jsonpath='{.status.containerStatuses[0].imageID}' 2>/dev/null || true
  )"
  waiting_reason="$(
    kubectl get pod "$pod_name" -n "$smoke_namespace" \
      -o jsonpath='{.status.containerStatuses[0].state.waiting.reason}' 2>/dev/null || true
  )"

  if [[ -n "$image_id" ]]; then
    printf 'ok: pod %s/%s pulled %s\n' "$smoke_namespace" "$pod_name" "$image"
    kubectl delete pod "$pod_name" -n "$smoke_namespace" --ignore-not-found --wait=false >/dev/null
    exit 0
  fi

  case "$waiting_reason" in
    ErrImagePull|ImagePullBackOff|InvalidImageName)
      kubectl describe pod "$pod_name" -n "$smoke_namespace" >&2 || true
      kubectl delete pod "$pod_name" -n "$smoke_namespace" --ignore-not-found --wait=false >/dev/null
      printf 'pod %s/%s failed to pull %s: %s\n' "$smoke_namespace" "$pod_name" "$image" "$waiting_reason" >&2
      exit 1
      ;;
  esac

  sleep 3
done

kubectl describe pod "$pod_name" -n "$smoke_namespace" >&2 || true
kubectl delete pod "$pod_name" -n "$smoke_namespace" --ignore-not-found --wait=false >/dev/null
printf 'timed out waiting for pod %s/%s to pull %s\n' "$smoke_namespace" "$pod_name" "$image" >&2
exit 1
