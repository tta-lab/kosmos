#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-}"
if [[ -z "$repo_root" ]]; then
  if [[ -f flake.nix && -f secrets.nix ]]; then
    repo_root="$PWD"
  else
    repo_root="/home/neil/code/projects/tta-lab/kosmos"
  fi
fi

server_secret="${repo_root}/secrets/woodpecker-server-env.age"
agent_secret="${repo_root}/secrets/woodpecker-agent-env.age"
failures=0

check() {
  local name="$1"
  shift

  if "$@"; then
    printf 'ok: %s\n' "$name"
  else
    printf 'fail: %s\n' "$name" >&2
    failures=$((failures + 1))
  fi
}

file_exists() {
  [[ -f "$1" ]]
}

socket_exists() {
  [[ -S "$1" ]]
}

unit_active() {
  systemctl is-active --quiet "$1"
}

unit_known() {
  systemctl list-unit-files "$1" --no-legend 2>/dev/null | grep -q "^$1"
}

printf 'repo: %s\n' "$repo_root"

check "Dagger Unix socket exists" socket_exists /run/dagger/engine.sock
check "Podman socket exists" socket_exists /run/podman/podman.sock

if file_exists "$server_secret" && file_exists "$agent_secret"; then
  printf 'Woodpecker age secrets are present; expecting services to be generated and active.\n'
  check "woodpecker-server unit exists" unit_known woodpecker-server.service
  check "woodpecker-agent-wsl-podman unit exists" unit_known woodpecker-agent-wsl-podman.service
  check "woodpecker-server active" unit_active woodpecker-server.service
  check "woodpecker-agent-wsl-podman active" unit_active woodpecker-agent-wsl-podman.service
else
  printf 'pending: Woodpecker age secrets are not both present.\n'
  printf 'missing check: %s\n' "$server_secret"
  printf 'missing check: %s\n' "$agent_secret"
  printf 'This is expected before creating Forgejo OAuth credentials and the shared agent secret.\n'
fi

if [[ "$failures" -gt 0 ]]; then
  printf '%s Woodpecker preflight check(s) failed\n' "$failures" >&2
  exit 1
fi
