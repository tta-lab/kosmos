#!/usr/bin/env bash
set -euo pipefail

namespace="devops"
deployment="forgejo"
pvc="gitea-shared-storage"
target_base="/var/lib/forgejo-migration-dry-runs"
copy_image="busybox:1.36"
execute_copy=0
confirm_stop_source=0
keep_pod=0

usage() {
  cat >&2 <<'EOF'
usage: forgejo-migration-dry-run [--preflight]
       forgejo-migration-dry-run --execute-copy --confirm-stop-source

Options:
  --namespace <name>          Source namespace. Default: devops
  --deployment <name>         Source Forgejo deployment. Default: forgejo
  --pvc <name>                Source PVC mounted as /data. Default: gitea-shared-storage
  --target-base <path>        Local WSL dry-run copy root. Default: /var/lib/forgejo-migration-dry-runs
  --copy-image <image>        Temporary pod image with tar. Default: busybox:1.36
  --keep-pod                  Keep temporary copy pod for inspection
  --execute-copy              Actually stop source deployment and copy /data
  --confirm-stop-source       Required with --execute-copy
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --preflight)
      execute_copy=0
      shift
      ;;
    --namespace)
      namespace="$2"
      shift 2
      ;;
    --deployment)
      deployment="$2"
      shift 2
      ;;
    --pvc)
      pvc="$2"
      shift 2
      ;;
    --target-base)
      target_base="$2"
      shift 2
      ;;
    --copy-image)
      copy_image="$2"
      shift 2
      ;;
    --keep-pod)
      keep_pod=1
      shift
      ;;
    --execute-copy)
      execute_copy=1
      shift
      ;;
    --confirm-stop-source)
      confirm_stop_source=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

require kubectl
require sudo
require tar
require date

print_preflight() {
  printf 'source deployment:\n'
  kubectl get deploy "$deployment" -n "$namespace" \
    -o custom-columns='NAME:.metadata.name,READY:.status.readyReplicas,REPLICAS:.spec.replicas,IMAGE:.spec.template.spec.containers[0].image'

  printf '\nsource pvc:\n'
  kubectl get pvc "$pvc" -n "$namespace" \
    -o custom-columns='NAME:.metadata.name,STATUS:.status.phase,VOLUME:.spec.volumeName,SC:.spec.storageClassName,SIZE:.spec.resources.requests.storage'

  printf '\nsource pods:\n'
  kubectl get pod -n "$namespace" \
    -l "app.kubernetes.io/name=forgejo,app.kubernetes.io/instance=forgejo" \
    -o wide

  printf '\nlocal target filesystem:\n'
  sudo mkdir -p "$target_base"
  df -h "$target_base"
}

print_preflight

if [[ "$execute_copy" -eq 0 ]]; then
  printf '\npreflight only. No source deployment was stopped.\n'
  exit 0
fi

if [[ "$confirm_stop_source" -ne 1 ]]; then
  printf '\nrefusing to run: --execute-copy requires --confirm-stop-source\n' >&2
  exit 2
fi

original_replicas="$(
  kubectl get deploy "$deployment" -n "$namespace" -o jsonpath='{.spec.replicas}'
)"
if [[ -z "$original_replicas" ]]; then
  original_replicas=1
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="${target_base}/${deployment}-${timestamp}"
pod="${deployment}-data-copy-${timestamp,,}"

restore() {
  local exit_code=$?

  if [[ "$keep_pod" -ne 1 ]]; then
    kubectl delete pod "$pod" -n "$namespace" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi

  kubectl scale deploy "$deployment" -n "$namespace" --replicas="$original_replicas" >/dev/null 2>&1 || true
  exit "$exit_code"
}
trap restore EXIT

printf '\nstopping source deployment %s/%s for cold copy...\n' "$namespace" "$deployment"
kubectl scale deploy "$deployment" -n "$namespace" --replicas=0
kubectl rollout status deploy "$deployment" -n "$namespace" --timeout=180s

sudo mkdir -p "$target"

cat <<EOF | kubectl apply -n "$namespace" -f -
apiVersion: v1
kind: Pod
metadata:
  name: ${pod}
spec:
  restartPolicy: Never
  containers:
    - name: copy
      image: ${copy_image}
      command: ["sh", "-c", "sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
          readOnly: true
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: ${pvc}
        readOnly: true
EOF

kubectl wait pod "$pod" -n "$namespace" --for=condition=Ready --timeout=180s

printf 'copying /data to %s...\n' "$target"
kubectl exec "$pod" -n "$namespace" -- tar -C /data -cf - . | sudo tar -C "$target" -xf -

printf 'dry-run copy complete: %s\n' "$target"
