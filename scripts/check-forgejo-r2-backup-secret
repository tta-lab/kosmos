#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
expected_server="https://127.0.0.1:26443"
namespace="devops"
secret_name="forgejo-r2-backup"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

secret_json="$("${kubectl_local[@]}" get secret "$secret_name" --namespace "$namespace" -o json)"
for key in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY RESTIC_PASSWORD RESTIC_REPOSITORY; do
  if [[ "$(jq -r --arg key "$key" '.data[$key] // ""' <<<"$secret_json")" == '' ]]; then
    printf 'Kubernetes Secret %s/%s is missing key: %s\n' "$namespace" "$secret_name" "$key" >&2
    exit 1
  fi
done

printf 'Kubernetes Secret %s/%s is present with all backup keys\n' "$namespace" "$secret_name"
