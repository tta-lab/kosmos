#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != 'https://127.0.0.1:26443' ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace penpot --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null
existing="$("${kubectl_local[@]}" get secret penpot-credentials -n penpot --ignore-not-found -o name)"
if [[ -n "$existing" ]]; then
  printf 'Kept existing Penpot credentials\n'
  exit 0
fi

# Losing the Secret must not silently replace the password of an existing DB.
existing_data="$("${kubectl_local[@]}" get pvc penpot-postgres-data -n penpot --ignore-not-found -o name)"
if [[ -n "$existing_data" ]]; then
  printf 'Penpot data already exists; restore penpot-credentials before deploying\n' >&2
  exit 1
fi

umask 077
secret_dir="$(mktemp -d)"
trap 'rm -rf -- "$secret_dir"' EXIT
openssl rand -hex 32 | tr -d '\n' >"$secret_dir/postgres-password"
openssl rand -base64 64 | tr -d '\n' >"$secret_dir/master-key"
"${kubectl_local[@]}" create secret generic penpot-credentials -n penpot \
  --from-file=POSTGRES_PASSWORD="$secret_dir/postgres-password" \
  --from-file=PENPOT_SECRET_KEY="$secret_dir/master-key" >/dev/null
printf 'Created Penpot credentials\n'
