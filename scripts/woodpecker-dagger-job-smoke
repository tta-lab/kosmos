#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-}"
if [[ -z "$repo_root" ]]; then
  if [[ -f flake.nix && -f secrets.nix ]]; then
    repo_root="$PWD"
  else
    repo_root="/home/neil/code/projects/tta-lab/kosmos"
  fi
fi

pipeline_file="${WOODPECKER_SMOKE_PIPELINE_FILE:-${repo_root}/fixtures/woodpecker/dagger-unix-socket-smoke.yml}"
server="${WOODPECKER_SERVER:-http://127.0.0.1:9000}"
repo="${WOODPECKER_SMOKE_REPO:-}"
branch="${WOODPECKER_SMOKE_BRANCH:-main}"
token="${WOODPECKER_TOKEN:-}"
token_file="${WOODPECKER_TOKEN_FILE:-}"
timeout_seconds="${WOODPECKER_SMOKE_TIMEOUT_SECONDS:-300}"
lint_only=0

usage() {
  cat >&2 <<'EOF'
usage: woodpecker-dagger-job-smoke [--lint-only]

Lint the Dagger Unix socket smoke pipeline. If WOODPECKER_TOKEN or
WOODPECKER_TOKEN_FILE and WOODPECKER_SMOKE_REPO are set, also trigger a
Woodpecker pipeline and wait for it to finish.

Environment:
  WOODPECKER_SERVER                 Default: http://127.0.0.1:9000
  WOODPECKER_TOKEN                  Woodpecker personal token
  WOODPECKER_TOKEN_FILE             File containing the token
  WOODPECKER_SMOKE_REPO             Repo full name known to Woodpecker, for example neil/kosmos-woodpecker-smoke
  WOODPECKER_SMOKE_BRANCH           Default: main
  WOODPECKER_SMOKE_PIPELINE_FILE    Default: fixtures/woodpecker/dagger-unix-socket-smoke.yml
  WOODPECKER_SMOKE_TIMEOUT_SECONDS  Default: 300
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lint-only)
      lint_only=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

read_token() {
  if [[ -n "$token" ]]; then
    printf '%s' "$token"
    return
  fi

  if [[ -n "$token_file" ]]; then
    if [[ ! -r "$token_file" ]]; then
      printf 'missing readable Woodpecker token file: %s\n' "$token_file" >&2
      exit 1
    fi
    tr -d '\r\n' < "$token_file"
  fi
}

unit_active() {
  systemctl is-active --quiet "$1"
}

pipeline_number_from_json() {
  jq -r '.number // .id // empty'
}

pipeline_status_from_json() {
  jq -r '.status // .state // empty'
}

require jq
require systemctl
require woodpecker-cli

if [[ ! -f "$pipeline_file" ]]; then
  printf 'missing Woodpecker smoke pipeline file: %s\n' "$pipeline_file" >&2
  exit 1
fi

woodpecker-cli lint --strict "$pipeline_file"
printf 'ok: Woodpecker smoke pipeline lint passed: %s\n' "$pipeline_file"

if [[ "$lint_only" -eq 1 ]]; then
  exit 0
fi

if [[ -z "$repo" ]]; then
  printf 'pending: set WOODPECKER_SMOKE_REPO to trigger a real Woodpecker pipeline\n'
  exit 0
fi

effective_token="$(read_token)"
if [[ -z "$effective_token" ]]; then
  printf 'pending: set WOODPECKER_TOKEN or WOODPECKER_TOKEN_FILE to trigger a real Woodpecker pipeline\n'
  exit 0
fi

unit_active woodpecker-server.service || {
  printf 'woodpecker-server.service is not active\n' >&2
  exit 1
}
unit_active woodpecker-agent-wsl-podman.service || {
  printf 'woodpecker-agent-wsl-podman.service is not active\n' >&2
  exit 1
}

export WOODPECKER_SERVER="$server"
export WOODPECKER_TOKEN="$effective_token"
export WOODPECKER_DISABLE_UPDATE_CHECK=true

woodpecker-cli info >/dev/null
printf 'ok: Woodpecker CLI authenticated against %s\n' "$server"

create_output="$(
  woodpecker-cli pipeline create "$repo" \
    --branch "$branch" \
    --output json
)"
pipeline_number="$(pipeline_number_from_json <<<"$create_output")"
if [[ -z "$pipeline_number" ]]; then
  printf 'failed to parse pipeline number from Woodpecker output:\n%s\n' "$create_output" >&2
  exit 1
fi

printf 'created Woodpecker pipeline %s for %s on %s\n' "$pipeline_number" "$repo" "$branch"

deadline=$((SECONDS + timeout_seconds))
while [[ "$SECONDS" -lt "$deadline" ]]; do
  show_output="$(woodpecker-cli pipeline show "$repo" "$pipeline_number" --output json)"
  status="$(pipeline_status_from_json <<<"$show_output")"

  case "$status" in
    success)
      printf 'Woodpecker Dagger job smoke passed: %s pipeline %s\n' "$repo" "$pipeline_number"
      exit 0
      ;;
    failure|error|killed|blocked|declined)
      woodpecker-cli pipeline ps "$repo" "$pipeline_number" >&2 || true
      woodpecker-cli pipeline log show "$repo" "$pipeline_number" >&2 || true
      printf 'Woodpecker pipeline %s ended with status %s\n' "$pipeline_number" "$status" >&2
      exit 1
      ;;
    "")
      printf 'waiting for Woodpecker pipeline %s: status unavailable\n' "$pipeline_number"
      ;;
    *)
      printf 'waiting for Woodpecker pipeline %s: %s\n' "$pipeline_number" "$status"
      ;;
  esac

  sleep 5
done

woodpecker-cli pipeline ps "$repo" "$pipeline_number" >&2 || true
woodpecker-cli pipeline log show "$repo" "$pipeline_number" >&2 || true
printf 'timed out waiting for Woodpecker pipeline %s after %s seconds\n' "$pipeline_number" "$timeout_seconds" >&2
exit 1
