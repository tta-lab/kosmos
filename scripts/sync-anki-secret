#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"
if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo "usage: sync-anki-secret [--validate-only] ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == "-" ]]; then
  env_file=/dev/stdin
elif [[ ! -s "$env_file" ]]; then
  printf 'missing or empty Anki environment file: %s\n' "$env_file" >&2
  exit 1
fi

line_count=0
sync_user=""
while IFS= read -r line || [[ -n "$line" ]]; do
  line_count=$((line_count + 1))
  if [[ "$line" != SYNC_USER1=* ]]; then
    echo "unexpected key in Anki environment" >&2
    exit 1
  fi
  sync_user="${line#SYNC_USER1=}"
done <"$env_file"

if [[ "$line_count" -ne 1 || "$sync_user" != ooneil:* || "$sync_user" == "ooneil:" ]]; then
  echo "Anki environment must contain exactly SYNC_USER1=ooneil:<password>" >&2
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo "Anki environment validation passed"
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace anki --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

"${kubectl_local[@]}" create secret generic anki-sync-env \
  --namespace anki \
  --from-env-file="$env_file" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

secret_version="$(
  "${kubectl_local[@]}" get secret anki-sync-env \
    --namespace anki \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$secret_version" ]]; then
  echo "Anki Secret has no resourceVersion" >&2
  exit 1
fi

if "${kubectl_local[@]}" get deployment/anki-sync-server --namespace anki >/dev/null 2>&1; then
  "${kubectl_local[@]}" patch deployment/anki-sync-server \
    --namespace anki \
    --type=merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/anki-secret-version\":\"${secret_version}\"}}}}}" \
    >/dev/null
  if ! "${kubectl_local[@]}" rollout status deployment/anki-sync-server \
    --namespace anki \
    --timeout=180s; then
    echo "rollout did not complete for deployment/anki-sync-server" >&2
    exit 1
  fi
fi

echo "Anki Secret synchronized to local K3s"
