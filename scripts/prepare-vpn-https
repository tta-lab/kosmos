#!/usr/bin/env bash
# Runs as Caddy before start/reload; unavailable VPN inputs leave HTTP intact.
set -euo pipefail
credential=$1 template=$2 output=$3
mkdir -p "$(dirname "$output")"
rm -f "$output"
skip() { printf 'VPN HTTPS disabled: %s; loopback HTTP remains available\n' "$1" >&2; exit 0; }
[[ -r "$credential" ]] || skip 'Cloudflare credential not readable'
ip -4 -o address show dev tun0 2>/dev/null | grep -q ' inet 10\.80\.12\.5/24 ' || skip 'tun0 must have 10.80.12.5/24'
# Match the pinned provider's formats and Caddy file placeholder's CRLF handling.
# The sentinel preserves trailing newlines so multi-line inputs cannot pass.
token=$(cat "$credential"; printf '.')
token=${token%.}
token=${token%$'\n'}
token=${token%$'\r'}
[[ "$token" =~ ^([A-Za-z0-9_-]{35,50}|cf(ut|at)_[A-Za-z0-9_-]{32,256})$ ]] || skip 'Cloudflare credential format invalid'
unset token
# validate provisions modules without starting ACME; suppress raw diagnostics.
caddy validate --config "$template" --adapter caddyfile >/dev/null 2>&1 || skip 'DNS-01 configuration validation failed'
install -m 0600 "$template" "$output"
