#!/usr/bin/env bash
set -eu
# Fix the Shio instance after EnvironmentFile loading; never inherit overrides.
export MATRIX_MCP_LISTEN=127.0.0.1:8769
export MATRIX_WEBHOOK_URL=http://127.0.0.1:3084/api/matrix/events
unset MATRIX_WEBHOOK_BEARER_TOKEN
if [ ! -r "$2" ]; then
  echo 'Shio Matrix MCP artifact missing; build the managed MFA checkout first' >&2
  exit 1
fi
exec "$1" "$2"
