#!/usr/bin/env bash
set -euo pipefail

strict=0
deep=0
smoke_token_file="${FORGEJO_SMOKE_TOKEN_FILE:-/home/neil/.config/kosmos/forgejo-smoke-token}"

usage() {
  cat <<'EOF'
usage: devops-gate-status [--strict] [--deep]

Report WSL DevOps Box migration gates without reading secret plaintext.

Options:
  --strict  Exit non-zero when any gate is pending or failed
  --deep    Run checks that may create temporary cluster objects, such as the
            Kubernetes private image pull smoke

Environment:
  FORGEJO_SMOKE_TOKEN_FILE  Package-write smoke token file checked by this
                            command. Default: /home/neil/.config/kosmos/forgejo-smoke-token
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --strict)
      strict=1
      shift
      ;;
    --deep)
      deep=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

failures=0
pending=0

ok() {
  printf 'ok: %s\n' "$1"
}

fail() {
  printf 'fail: %s\n' "$1" >&2
  failures=$((failures + 1))
}

wait() {
  printf 'pending: %s\n' "$1"
  pending=$((pending + 1))
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

unit_active() {
  systemctl is-active --quiet "$1"
}

file_exists() {
  [[ -f "$1" ]]
}

socket_exists() {
  [[ -S "$1" ]]
}

file_nonempty_maybe_root() {
  local path="$1"

  [[ -s "$path" ]] || sudo -n test -s "$path" 2>/dev/null
}

http_status_ok() {
  local url="$1"
  local status

  status="$(curl --silent --output /dev/null --write-out '%{http_code}' "$url" || true)"
  case "$status" in
    200|401)
      return 0
      ;;
    *)
      printf 'unexpected status for %s: %s\n' "$url" "$status" >&2
      return 1
      ;;
  esac
}

different_filesystems() {
  local left="$1"
  local right="$2"

  [[ "$(stat -c '%d' "$left")" != "$(stat -c '%d' "$right")" ]]
}

printf 'WSL DevOps Box gate status\n'

if unit_active forgejo.service; then
  ok "Forgejo service active"
else
  fail "Forgejo service active"
fi

if unit_active podman-dagger-engine.service; then
  ok "Dagger engine service active"
else
  fail "Dagger engine service active"
fi

if unit_active forgejo-internal-registry-proxy.service; then
  ok "internal Forgejo registry proxy active"
else
  fail "internal Forgejo registry proxy active"
fi

if http_status_ok http://127.0.0.1:3000/; then
  ok "local Forgejo HTTP responds"
else
  fail "local Forgejo HTTP responds"
fi

if http_status_ok https://git-wsl.guion.io/v2/; then
  ok "public staging registry endpoint responds"
else
  fail "public staging registry endpoint responds"
fi

if http_status_ok http://10.88.0.1:3000/v2/; then
  ok "internal staging registry endpoint responds"
else
  fail "internal staging registry endpoint responds"
fi

if socket_exists /run/dagger/engine.sock; then
  ok "Dagger Unix socket exists"
else
  fail "Dagger Unix socket exists"
fi

if socket_exists /run/podman/podman.sock; then
  ok "Podman socket exists"
else
  fail "Podman socket exists"
fi

if file_nonempty_maybe_root "$smoke_token_file"; then
  ok "Forgejo package-write smoke token file exists"
else
  wait "Forgejo package-write smoke token file missing or empty: ${smoke_token_file}"
fi

if file_exists secrets/woodpecker-server-env.age && file_exists secrets/woodpecker-agent-env.age; then
  ok "Woodpecker age secrets tracked"
  if unit_active woodpecker-server.service && unit_active woodpecker-agent-wsl-podman.service; then
    ok "Woodpecker services active"
  else
    fail "Woodpecker services active"
  fi
else
  wait "Woodpecker age secrets not created"
fi

if mountpoint -q /mnt/nuc-data; then
  ok "NUC data disk mounted at /mnt/nuc-data"
else
  wait "NUC data disk not mounted at /mnt/nuc-data"
fi

if [[ -d /var/lib/forgejo && -d /var/backup/forgejo ]]; then
  if different_filesystems /var/lib/forgejo /var/backup/forgejo; then
    ok "Forgejo backup directory is off live state filesystem"
  else
    wait "Forgejo backup directory is still on live state filesystem"
  fi
else
  fail "Forgejo state and backup directories exist"
fi

if have_command kubectl; then
  if kubectl get secret forgejo-packages -n devops -o jsonpath='{.type}' 2>/dev/null | grep -qx 'kubernetes.io/dockerconfigjson'; then
    ok "source Kubernetes pull secret exists with dockerconfigjson type"
  else
    wait "source Kubernetes pull secret not verified"
  fi

  for namespace in apps-dev apps-prod apps-share; do
    if kubectl get secret forgejo-packages -n "$namespace" -o jsonpath='{.type}' 2>/dev/null | grep -qx 'kubernetes.io/dockerconfigjson'; then
      ok "mirrored Kubernetes pull secret exists in ${namespace}"
    else
      wait "mirrored Kubernetes pull secret not verified in ${namespace}"
    fi
  done
else
  wait "kubectl unavailable; skipped Kubernetes pull-secret checks"
fi

if [[ "$deep" -eq 1 ]]; then
  if have_command kosmos-forgejo-k8s-pull-secret-smoke; then
    if kosmos-forgejo-k8s-pull-secret-smoke; then
      ok "deep Kubernetes private image pull smoke"
    else
      fail "deep Kubernetes private image pull smoke"
    fi
  else
    wait "kosmos-forgejo-k8s-pull-secret-smoke unavailable"
  fi
else
  wait "deep Kubernetes private image pull smoke skipped"
fi

printf 'summary: %s failed, %s pending\n' "$failures" "$pending"

if [[ "$failures" -gt 0 ]]; then
  exit 1
fi

if [[ "$strict" -eq 1 && "$pending" -gt 0 ]]; then
  exit 1
fi
