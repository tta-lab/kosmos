#!/usr/bin/env bash
set -euo pipefail

strict=0
local_kubeconfig="/etc/rancher/k3s/k3s.yaml"
local_api_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$local_kubeconfig")

usage() {
  cat <<'EOF'
usage: devops-gate-status [--strict]

Report SW application health and local WSL build-host gates without reading secret plaintext.

Options:
  --strict  Exit non-zero when any gate is pending or failed
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --strict)
      strict=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

failures=0
pending=0

ok() {
  printf 'ok: %s\n' "$1"
}

fail() {
  printf 'fail: %s\n' "$1" >&2
  failures=$((failures + 1))
}

wait() {
  printf 'pending: %s\n' "$1"
  pending=$((pending + 1))
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

unit_active() {
  systemctl is-active --quiet "$1"
}

http_status_ok() {
  local url="$1"
  local status

  status="$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' "$url" || true)"
  case "$status" in
    200|204)
      return 0
      ;;
    *)
      printf 'unexpected status for %s: %s\n' "$url" "$status" >&2
      return 1
      ;;
  esac
}

printf 'SW services and WSL build-host gate status\n'

if unit_active k3s.service; then
  ok "K3s service active"
else
  fail "K3s service active"
fi

if http_status_ok https://192.168.6.186:8086/api/healthz; then
  ok "Forgejo endpoint responds (SW)"
else
  fail "Forgejo endpoint responds (SW)"
fi

if have_command kubectl; then
  actual_api_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null || true)"
  if [[ "$actual_api_server" != "$local_api_server" ]]; then
    printf 'refusing non-local cluster: %s\n' "${actual_api_server:-unknown}" >&2
    exit 1
  fi
fi

# TCP only: a listener is not proof of Engine health or build readiness.
if timeout 3 bash -c ': </dev/tcp/127.0.0.1/8080' 2>/dev/null; then
  ok "Dagger relay TCP reachable"
else
  fail "Dagger relay TCP reachable"
fi

if http_status_ok https://192.168.6.186:8087/healthz; then
  ok "Woodpecker endpoint responds (SW)"
else
  fail "Woodpecker endpoint responds (SW)"
fi

printf 'summary: %s failed, %s pending\n' "$failures" "$pending"

if [[ "$failures" -gt 0 ]]; then
  exit 1
fi

if [[ "$strict" -eq 1 && "$pending" -gt 0 ]]; then
  exit 1
fi
