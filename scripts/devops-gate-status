#!/usr/bin/env bash
set -euo pipefail

strict=0
deep=0
smoke_token_file="${FORGEJO_SMOKE_TOKEN_FILE:-/home/neil/.config/kosmos/forgejo-smoke-token}"
local_kubeconfig="/etc/rancher/k3s/k3s.yaml"
local_api_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$local_kubeconfig")

usage() {
  cat <<'EOF'
usage: devops-gate-status [--strict] [--deep]

Report the local WSL K3s DevOps stack gates without reading secret plaintext.

Options:
  --strict  Exit non-zero when any gate is pending or failed
  --deep    Run checks that may create temporary cluster objects, such as the
            Kubernetes private image pull smoke

Environment:
  FORGEJO_SMOKE_TOKEN_FILE  Package-write smoke token file checked by this
                            command. Default: /home/neil/.config/kosmos/forgejo-smoke-token
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --strict)
      strict=1
      shift
      ;;
    --deep)
      deep=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

failures=0
pending=0

ok() {
  printf 'ok: %s\n' "$1"
}

fail() {
  printf 'fail: %s\n' "$1" >&2
  failures=$((failures + 1))
}

wait() {
  printf 'pending: %s\n' "$1"
  pending=$((pending + 1))
}

skip() {
  printf 'skipped: %s\n' "$1"
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

unit_active() {
  systemctl is-active --quiet "$1"
}

file_nonempty_maybe_root() {
  local path="$1"

  [[ -s "$path" ]] || sudo -n test -s "$path" 2>/dev/null
}

http_status_ok() {
  local url="$1"
  local status

  status="$(curl --silent --output /dev/null --write-out '%{http_code}' "$url" || true)"
  case "$status" in
    200|401)
      return 0
      ;;
    *)
      printf 'unexpected status for %s: %s\n' "$url" "$status" >&2
      return 1
      ;;
  esac
}

printf 'WSL DevOps Box gate status\n'

if unit_active k3s.service; then
  ok "K3s service active"
else
  fail "K3s service active"
fi

if http_status_ok http://forgejo.localhost:17480/api/healthz; then
  ok "Forgejo endpoint responds (K3s)"
else
  fail "Forgejo endpoint responds (K3s)"
fi

if file_nonempty_maybe_root "$smoke_token_file"; then
  ok "Forgejo package-write smoke token file exists"
else
  wait "Forgejo package-write smoke token file missing or empty: ${smoke_token_file}"
fi

if have_command kubectl; then
  actual_api_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null || true)"
  if [[ "$actual_api_server" != "$local_api_server" ]]; then
    printf 'refusing non-local cluster: %s\n' "${actual_api_server:-unknown}" >&2
    exit 1
  fi
  export KUBECONFIG="$local_kubeconfig"
fi

if unit_active woodpecker-secret-sync.service; then
  ok "Woodpecker Secret sync service active"
else
  fail "Woodpecker Secret sync service active"
fi

if file_nonempty_maybe_root /run/agenix/woodpecker-server-env; then
  ok "Woodpecker agenix runtime secret exists"
else
  fail "Woodpecker agenix runtime secret exists"
fi

if have_command kubectl; then
  if "${kubectl_local[@]}" get secret woodpecker-server-env -n devops -o name 2>/dev/null | grep -q "secret/woodpecker-server-env"; then
    ok "Woodpecker K3s secret exists"
  else
    fail "Woodpecker K3s secret missing"
  fi
else
  wait "kubectl unavailable; skipped Woodpecker secret check"
fi

if have_command kubectl; then
  if "${kubectl_local[@]}" get secret forgejo-packages -n devops -o jsonpath='{.type}' 2>/dev/null | grep -qx 'kubernetes.io/dockerconfigjson'; then
    ok "source Kubernetes pull secret exists with dockerconfigjson type"
  else
    wait "source Kubernetes pull secret not verified"
  fi

  for namespace in apps-dev apps-prod apps-share; do
    if "${kubectl_local[@]}" get secret forgejo-packages -n "$namespace" -o jsonpath='{.type}' 2>/dev/null | grep -qx 'kubernetes.io/dockerconfigjson'; then
      ok "mirrored Kubernetes pull secret exists in ${namespace}"
    else
      wait "mirrored Kubernetes pull secret not verified in ${namespace}"
    fi
  done
else
  wait "kubectl unavailable; skipped Kubernetes pull-secret checks"
fi

if [[ "$deep" -eq 1 ]]; then
  if have_command kosmos-forgejo-k8s-pull-secret-smoke; then
    if kosmos-forgejo-k8s-pull-secret-smoke; then
      ok "deep Kubernetes private image pull smoke"
    else
      fail "deep Kubernetes private image pull smoke"
    fi
  else
    wait "kosmos-forgejo-k8s-pull-secret-smoke unavailable"
  fi
else
  skip "deep Kubernetes private image pull smoke"
fi

printf 'summary: %s failed, %s pending\n' "$failures" "$pending"

if [[ "$failures" -gt 0 ]]; then
  exit 1
fi

if [[ "$strict" -eq 1 && "$pending" -gt 0 ]]; then
  exit 1
fi
