#!/usr/bin/env bash
set -euo pipefail

engine_unit="${DAGGER_ENGINE_UNIT:-podman-dagger-engine.service}"
local_forgejo_url="${FORGEJO_LOCAL_URL:-http://127.0.0.1:3000/}"
public_registry_url="${FORGEJO_PUBLIC_REGISTRY_URL:-https://git.guion.io/v2/}"
internal_registry_url="${FORGEJO_INTERNAL_REGISTRY_URL:-http://10.88.0.1:3000/v2/}"
socket_path="${DAGGER_ENGINE_SOCKET:-/run/dagger/engine.sock}"

usage() {
  cat <<'EOF'
usage: dagger-engine-isolation-smoke

Temporarily stops the local Dagger engine and verifies Forgejo's local and
public registry endpoints still respond. The helper then starts the Dagger
engine again and verifies the Unix socket and WSL-internal registry endpoint
return.

Run this helper as root because it stops and starts a system service.

Environment:
  DAGGER_ENGINE_UNIT             systemd unit to stop/start. Default: podman-dagger-engine.service
  DAGGER_ENGINE_SOCKET           Dagger Unix socket path. Default: /run/dagger/engine.sock
  FORGEJO_LOCAL_URL              Local Forgejo URL. Default: http://127.0.0.1:3000/
  FORGEJO_PUBLIC_REGISTRY_URL    Public registry URL. Default: https://git.guion.io/v2/
  FORGEJO_INTERNAL_REGISTRY_URL  Internal registry URL. Default: http://10.88.0.1:3000/v2/
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$#" -gt 0 ]]; then
  usage >&2
  exit 2
fi

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

http_status_ok() {
  local url="$1"
  local status

  status="$(curl --silent --output /dev/null --write-out '%{http_code}' "$url" || true)"
  case "$status" in
    200|401)
      printf 'ok: %s responded with %s\n' "$url" "$status"
      ;;
    *)
      printf 'unexpected status for %s: %s\n' "$url" "$status" >&2
      return 1
      ;;
  esac
}

wait_for_socket() {
  local path="$1"

  for _ in $(seq 1 30); do
    if [[ -S "$path" ]]; then
      printf 'ok: Dagger socket exists: %s\n' "$path"
      return 0
    fi
    sleep 1
  done

  printf 'Dagger socket did not return: %s\n' "$path" >&2
  return 1
}

require curl
require systemctl

if [[ "$EUID" -ne 0 ]]; then
  printf 'run as root, for example: sudo dagger-engine-isolation-smoke\n' >&2
  exit 1
fi

restart_engine() {
  systemctl start "$engine_unit" >/dev/null 2>&1 || true
}

trap restart_engine EXIT

printf 'stopping %s...\n' "$engine_unit"
systemctl stop "$engine_unit"

if systemctl is-active --quiet "$engine_unit"; then
  printf 'expected %s to be stopped\n' "$engine_unit" >&2
  exit 1
fi

http_status_ok "$local_forgejo_url"
http_status_ok "$public_registry_url"

printf 'starting %s...\n' "$engine_unit"
systemctl start "$engine_unit"
trap - EXIT

wait_for_socket "$socket_path"
http_status_ok "$internal_registry_url"

printf 'Dagger engine isolation smoke passed: Forgejo stayed reachable while %s was stopped and internal registry returned after restart\n' "$engine_unit"
