#!/usr/bin/env bash
set -euo pipefail

root=$1
shift
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_CACHE_HOME="$root/cache"
# matrix-mcp otherwise falls back to ~/.config/matrix-mcp (Shio).
test -s "$XDG_CONFIG_HOME/matrix-mcp/config.json" || {
  echo "Provision the independent Matrix config first" >&2
  exit 1
}
# Serialize before Matrix loads its numeric ID-map snapshot. --no-fork
# replaces flock with the child, retaining the lock until the child exits.
exec flock --exclusive --no-fork "$root/stdio.lock" "$@"
