#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
source_file="${KEPOS_POLICY_SOURCE:-$repo_root/kepos/publisher-policy.jsonnet}"
target_file="${KEPOS_PUBLISHER_POLICY_FILE:-/home/neil/.config/kepos/publisher.toml}"
target_dir="$(dirname -- "$target_file")"

if [[ ! -f "$source_file" ]]; then
  echo "Kepos policy source is missing: $source_file" >&2
  exit 1
fi

if ! command -v jsonnet >/dev/null 2>&1; then
  echo "jsonnet is required to render the Kepos publisher policy" >&2
  exit 1
fi

umask 077
mkdir -p -- "$target_dir"
temporary_file="$(mktemp "$target_dir/.publisher.toml.XXXXXX")"
cleanup() {
  rm -f -- "$temporary_file"
}
trap cleanup EXIT

jsonnet -S "$source_file" >"$temporary_file"
test -s "$temporary_file"
chmod 0600 "$temporary_file"
mv -f -- "$temporary_file" "$target_file"
trap - EXIT
