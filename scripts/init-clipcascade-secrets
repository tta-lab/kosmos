#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
expected_server="https://127.0.0.1:26443"
namespace="clipcascade"
secret_name="clipcascade-database"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace "$namespace" --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

if "${kubectl_local[@]}" get secret "$secret_name" --namespace "$namespace" >/dev/null 2>&1; then
  printf 'Kept existing ClipCascade database credentials\n'
  exit 0
fi

secret_parent="${CLIPCASCADE_SECRET_TMPDIR:-${TMPDIR:-/tmp}}"
secret_dir="$(mktemp -d "${secret_parent%/}/kosmos-clipcascade-secret.XXXXXX")"
trap 'rm -rf -- "$secret_dir"' EXIT
chmod 700 "$secret_dir"

umask 077
# H2 CIPHER=AES expects a file password and a user password separated by a
# space. Keep both values in the Kubernetes Secret and never print them.
printf '%s %s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" \
  >"$secret_dir/database-password"
chmod 600 "$secret_dir/database-password"

"${kubectl_local[@]}" create secret generic "$secret_name" \
  --namespace "$namespace" \
  --from-file="CC_SERVER_DB_PASSWORD=$secret_dir/database-password" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

printf 'Created ClipCascade database credentials\n'
