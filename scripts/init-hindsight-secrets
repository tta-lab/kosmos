#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
expected_server="https://127.0.0.1:26443"
namespace="hindsight"
secret_name="hindsight-database"
postgres_service="hindsight-postgres"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace "$namespace" --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

if "${kubectl_local[@]}" get secret "$secret_name" --namespace "$namespace" >/dev/null 2>&1; then
  printf 'Kept existing Hindsight database credentials\n'
  exit 0
fi

secret_parent="${HINDSIGHT_SECRET_TMPDIR:-${TMPDIR:-/tmp}}"
secret_dir="$(mktemp -d "${secret_parent%/}/kosmos-hindsight-secret.XXXXXX")"
trap 'rm -rf -- "$secret_dir"' EXIT
chmod 700 "$secret_dir"

umask 077
db_password="$(openssl rand -hex 32)"
printf 'POSTGRES_PASSWORD=%s\n' "$db_password" >"$secret_dir/database.env"
printf 'HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:%s@%s.%s.svc.cluster.local:5432/hindsight?sslmode=disable\n' \
  "$db_password" "$postgres_service" "$namespace" >>"$secret_dir/database.env"

"${kubectl_local[@]}" create secret generic "$secret_name" \
  --namespace "$namespace" \
  --from-env-file="$secret_dir/database.env" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

printf 'Created Hindsight database credentials\n'
