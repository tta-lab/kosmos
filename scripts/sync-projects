#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys
import tomllib
from pathlib import Path


def run(cmd, dry_run):
    print("+ " + " ".join(str(part) for part in cmd))
    if dry_run:
        return 0
    return subprocess.run(cmd, check=False).returncode


def expand(path):
    return Path(os.path.expanduser(path))


def repo_info(path, collections):
    for collection, root in collections.items():
        try:
            rel = path.relative_to(root)
        except ValueError:
            continue

        parts = rel.parts
        if len(parts) < 2:
            return None

        org, repo = parts[0], parts[1]
        repo_path = root / org / repo
        return collection, org, repo, repo_path

    return None


def default_remote(org, repo):
    return f"https://github.com/{org}/{repo}.git"


def project_entries(projects):
    for alias, entry in projects.items():
        if not isinstance(entry, dict):
            continue
        path = entry.get("path")
        if not isinstance(path, str):
            continue
        yield alias, entry, expand(path)


def sync_project(alias, entry, path, args, collections, seen):
    info = repo_info(path, collections)
    if info is None:
        return 0

    collection, org, repo, repo_path = info
    if args.collection != "all" and collection != args.collection:
        return 0
    if args.org and org not in args.org:
        return 0

    # Entries such as fb.ai point into a repo. The root entry handles the clone.
    if path != repo_path:
        return 0

    if repo_path in seen:
        return 0
    seen.add(repo_path)

    remote = entry.get("remote") or default_remote(org, repo)

    if repo_path.exists():
        probe = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if probe.returncode != 0:
            print(f"skip {alias}: {repo_path} exists but is not a git repo", file=sys.stderr)
            return 1

        if not args.no_fetch:
            return run(["git", "-C", str(repo_path), "fetch", "--prune"], args.dry_run)

        print(f"exists {alias}: {repo_path}")
        return 0

    parent = repo_path.parent
    if not args.dry_run:
        parent.mkdir(parents=True, exist_ok=True)
    else:
        print(f"+ mkdir -p {parent}")

    return run(["git", "clone", remote, str(repo_path)], args.dry_run)


def main():
    parser = argparse.ArgumentParser(
        description="Clone or fetch repos listed in ttal/projects.toml."
    )
    parser.add_argument(
        "--projects-file",
        default="~/.config/ttal/projects.toml",
        help="Path to projects.toml. Default: ~/.config/ttal/projects.toml",
    )
    parser.add_argument(
        "--collection",
        choices=["all", "projects", "references"],
        default="projects",
        help="Which collection to sync. Default: projects",
    )
    parser.add_argument(
        "--code-root",
        default=str(Path.home() / "code"),
        help="Root that contains projects/ and references/. Default: ~/code",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print git commands without running them.",
    )
    parser.add_argument(
        "--no-fetch",
        action="store_true",
        help="Do not fetch existing repos.",
    )
    parser.add_argument(
        "--org",
        action="append",
        help="Only sync repos whose path org matches this value. Can be repeated.",
    )
    args = parser.parse_args()

    projects_file = expand(args.projects_file)
    with projects_file.open("rb") as handle:
        projects = tomllib.load(handle)

    code_root = expand(args.code_root)
    collections = {
        "projects": code_root / "projects",
        "references": code_root / "references",
    }

    failed = 0
    seen = set()
    for alias, entry, path in project_entries(projects):
        if sync_project(alias, entry, path, args, collections, seen) != 0:
            failed += 1

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
