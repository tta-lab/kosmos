#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys
import tomllib
from pathlib import Path
from urllib.parse import urlsplit


FORGEJO_TOKEN_NAMES = (
    "FORGEJO_TOKEN",
    "FORGEJO_ACCESS_TOKEN",
    "GITEA_TOKEN",
)
FORGEJO_HOSTS = ("git.guion.io", "forgejo.localhost")


def parse_env_value(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def token_from_env(names, env_file):
    for name in names:
        if os.environ.get(name):
            return os.environ[name]

    try:
        lines = env_file.read_text().splitlines()
    except FileNotFoundError:
        return None

    values = {}
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line.removeprefix("export ").lstrip()
        name, separator, value = line.partition("=")
        name = name.strip()
        if separator and name in names:
            values[name] = parse_env_value(value)

    for name in names:
        if values.get(name):
            return values[name]
    return None


def token_env_names(remote, entry, org, orgs):
    parsed = urlsplit(remote)
    if parsed.scheme not in ("http", "https"):
        return ()

    if parsed.hostname in FORGEJO_HOSTS:
        return FORGEJO_TOKEN_NAMES

    if parsed.hostname != "github.com":
        return ()

    token_env = entry.get("github_token_env")
    if not isinstance(token_env, str) or not token_env:
        org_entry = orgs.get(org, {})
        if isinstance(org_entry, dict):
            token_env = org_entry.get("github_token_env")
    if isinstance(token_env, str) and token_env:
        return (token_env,)
    return ("GITHUB_TOKEN", "GH_TOKEN")


def git_env(remote, entry, org, orgs, env_file):
    names = token_env_names(remote, entry, org, orgs)
    if not names:
        return None

    token = token_from_env(names, env_file)
    if not token:
        return None

    parsed = urlsplit(remote)
    credential_host = parsed.hostname
    if parsed.port is not None:
        credential_host = f"{credential_host}:{parsed.port}"

    env = os.environ.copy()
    env.update(
        {
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_CONFIG_COUNT": "2",
            "GIT_CONFIG_KEY_0": "credential.helper",
            "GIT_CONFIG_VALUE_0": "",
            "GIT_CONFIG_KEY_1": "credential.helper",
            "GIT_CONFIG_VALUE_1": (
                "!f(){ requested_protocol=; requested_host=; "
                "while IFS='=' read -r key value; do "
                '[ "$key" = protocol ] && requested_protocol="$value"; '
                '[ "$key" = host ] && requested_host="$value"; '
                "done; "
                '[ "$requested_protocol" = "$GIT_CREDENTIAL_PROTOCOL" ] || '
                "return 0; "
                '[ "$requested_host" = "$GIT_CREDENTIAL_HOST" ] || return 0; '
                "echo username=x-access-token; "
                "echo password=$GIT_TOKEN_INJECT; }; f"
            ),
            "GIT_CREDENTIAL_PROTOCOL": parsed.scheme,
            "GIT_CREDENTIAL_HOST": credential_host,
            "GIT_TOKEN_INJECT": token,
        }
    )
    return env


def run(cmd, dry_run, env=None):
    print("+ " + " ".join(str(part) for part in cmd))
    if dry_run:
        return 0
    return subprocess.run(cmd, check=False, env=env).returncode


def remote_url(repo_path, remote_name):
    probe = subprocess.run(
        ["git", "-C", str(repo_path), "remote", "get-url", remote_name],
        capture_output=True,
        check=False,
        text=True,
    )
    if probe.returncode != 0:
        return None
    remote = probe.stdout.strip()
    return remote or None


def expand(path):
    return Path(os.path.expanduser(path))


def repo_info(path, collections):
    for collection, root in collections.items():
        try:
            rel = path.relative_to(root)
        except ValueError:
            continue

        parts = rel.parts
        if len(parts) < 2:
            return None

        org, repo = parts[0], parts[1]
        repo_path = root / org / repo
        return collection, org, repo, repo_path

    return None


def default_remote(org, repo):
    return f"https://github.com/{org}/{repo}.git"


def project_entries(projects):
    for alias, entry in projects.items():
        if not isinstance(entry, dict):
            continue
        path = entry.get("path")
        if not isinstance(path, str):
            continue
        yield alias, entry, expand(path)


def sync_project(alias, entry, path, args, collections, orgs, seen):
    if args.alias and alias not in args.alias:
        return 0

    info = repo_info(path, collections)
    if info is None:
        return 0

    collection, org, repo, repo_path = info
    if args.collection != "all" and collection != args.collection:
        return 0
    if args.org and org not in args.org:
        return 0

    # Entries such as fb.ai point into a repo. The root entry handles the clone.
    if path != repo_path:
        return 0

    if repo_path in seen:
        return 0
    seen.add(repo_path)

    remote = entry.get("remote") or default_remote(org, repo)

    if repo_path.exists():
        probe = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if probe.returncode != 0:
            print(f"skip {alias}: {repo_path} exists but is not a git repo", file=sys.stderr)
            return 1

        if not args.no_fetch:
            origin = remote_url(repo_path, "origin")
            if origin is None:
                print(
                    f"skip {alias}: could not resolve origin remote in {repo_path}",
                    file=sys.stderr,
                )
                return 1
            return run(
                ["git", "-C", str(repo_path), "fetch", "--prune", "origin"],
                args.dry_run,
                git_env(origin, entry, org, orgs, args.env_file),
            )

        print(f"exists {alias}: {repo_path}")
        return 0

    parent = repo_path.parent
    if not args.dry_run:
        parent.mkdir(parents=True, exist_ok=True)
    else:
        print(f"+ mkdir -p {parent}")

    return run(
        ["git", "clone", remote, str(repo_path)],
        args.dry_run,
        git_env(remote, entry, org, orgs, args.env_file),
    )


def main():
    parser = argparse.ArgumentParser(
        description="Clone or fetch repos listed in ttal/projects.toml."
    )
    parser.add_argument(
        "--projects-file",
        default="~/.config/ttal/projects.toml",
        help="Path to projects.toml. Default: ~/.config/ttal/projects.toml",
    )
    parser.add_argument(
        "--env-file",
        default="~/.config/ttal/.env",
        help="Path containing Git credentials. Default: ~/.config/ttal/.env",
    )
    parser.add_argument(
        "--collection",
        choices=["all", "projects", "references"],
        default="projects",
        help="Which collection to sync. Default: projects",
    )
    parser.add_argument(
        "--code-root",
        default=str(Path.home() / "code"),
        help="Root that contains projects/ and references/. Default: ~/code",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print git commands without running them.",
    )
    parser.add_argument(
        "--no-fetch",
        action="store_true",
        help="Do not fetch existing repos.",
    )
    parser.add_argument(
        "--org",
        action="append",
        help="Only sync repos whose path org matches this value. Can be repeated.",
    )
    parser.add_argument(
        "--alias",
        action="append",
        help="Only sync this project alias from projects.toml. Can be repeated.",
    )
    args = parser.parse_args()
    args.env_file = expand(args.env_file)

    projects_file = expand(args.projects_file)
    with projects_file.open("rb") as handle:
        projects = tomllib.load(handle)
    orgs_file = projects_file.with_name("orgs.toml")
    try:
        with orgs_file.open("rb") as handle:
            orgs = tomllib.load(handle)
    except FileNotFoundError:
        orgs = {}

    code_root = expand(args.code_root)
    collections = {
        "projects": code_root / "projects",
        "references": code_root / "references",
    }

    failed = 0
    seen = set()
    for alias, entry, path in project_entries(projects):
        if sync_project(alias, entry, path, args, collections, orgs, seen) != 0:
            failed += 1

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
