#!/usr/bin/env bash
set -euo pipefail

[[ "$#" -eq 1 && -s "$1" ]] || { echo 'usage: sync-caddy-secret TOKEN_FILE' >&2; exit 2; }
k=(kubectl --kubeconfig /etc/rancher/k3s/k3s.yaml --context default)
server="$("${k[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
[[ "$server" == https://127.0.0.1:26443 ]] || { echo 'refusing non-local cluster' >&2; exit 1; }
"${k[@]}" create namespace devops --dry-run=client -o yaml | "${k[@]}" apply -f - >/dev/null
"${k[@]}" create secret generic caddy-cloudflare --namespace devops \
  --from-file="CF_API_TOKEN=$1" --dry-run=client -o yaml \
  | "${k[@]}" apply -f - >/dev/null

# Environment-backed credentials require a new Pod after rotation.
version="$("${k[@]}" get secret caddy-cloudflare -n devops -o jsonpath='{.metadata.resourceVersion}')"
if "${k[@]}" get deployment canonical-gateway -n devops >/dev/null 2>&1; then
  "${k[@]}" patch deployment canonical-gateway -n devops --type merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/caddy-secret-version\":\"$version\"}}}}}" >/dev/null
fi
echo 'Caddy credential synchronized to local k3s'
