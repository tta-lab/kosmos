#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

server_env_file="${1:-}"
postgres_env_file="${2:-}"

if [[ -z "$server_env_file" || -z "$postgres_env_file" || "$#" -ne 2 ]]; then
  echo "usage: sync-woodpecker-secret [--validate-only] SERVER_ENV_FILE POSTGRES_ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$server_env_file" == "-" ]]; then
  server_env_file=/dev/stdin
fi

validate_env_file() {
  local env_file="$1"
  local label="$2"
  shift 2
  local required_key
  local key
  local value
  local validation_failed=0
  local required_keys=("$@")
  declare -A seen_keys=()
  declare -A invalid_keys=()

  if [[ ! -r "$env_file" ]]; then
    printf 'missing or unreadable Woodpecker %s environment file: %s\n' "$label" "$env_file" >&2
    return 1
  fi

  while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
    for required_key in "${required_keys[@]}"; do
      if [[ "$key" == "$required_key" ]]; then
        if [[ -n "${seen_keys[$key]+present}" || -z "$value" ]]; then
          invalid_keys[$key]=1
        fi
        seen_keys[$key]=1
        break
      fi
    done
  done <"$env_file"

  for required_key in "${required_keys[@]}"; do
    if [[ -z "${seen_keys[$required_key]+present}" || -n "${invalid_keys[$required_key]+invalid}" ]]; then
      printf 'missing, empty, or duplicate required key in %s environment: %s\n' "$label" "$required_key" >&2
      validation_failed=1
    fi
  done

  return "$validation_failed"
}

validate_env_file "$server_env_file" server \
  WOODPECKER_AGENT_SECRET \
  WOODPECKER_FORGEJO_CLIENT \
  WOODPECKER_FORGEJO_SECRET
validate_env_file "$postgres_env_file" PostgreSQL \
  POSTGRES_PASSWORD \
  WOODPECKER_DATABASE_DATASOURCE

if [[ "$validate_only" -eq 1 ]]; then
  echo "Woodpecker environment validation passed"
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace devops --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

apply_env_secret() {
  local secret_name="$1"
  local env_file="$2"

  "${kubectl_local[@]}" create secret generic "$secret_name" \
    --namespace devops \
    --from-env-file="$env_file" \
    --dry-run=client \
    -o yaml \
    | "${kubectl_local[@]}" apply -f - >/dev/null
}

apply_env_secret woodpecker-server-env "$server_env_file"
apply_env_secret woodpecker-postgres-env "$postgres_env_file"

server_secret_version="$(
  "${kubectl_local[@]}" get secret woodpecker-server-env \
    --namespace devops \
    -o jsonpath='{.metadata.resourceVersion}'
)"
postgres_secret_version="$(
  "${kubectl_local[@]}" get secret woodpecker-postgres-env \
    --namespace devops \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$server_secret_version" || -z "$postgres_secret_version" ]]; then
  echo "Woodpecker Secret has no resourceVersion" >&2
  exit 1
fi

secret_version="${server_secret_version}-${postgres_secret_version}"
resources=()
for resource in deployment/woodpecker statefulset/woodpecker-agent statefulset/woodpecker-postgres; do
  if "${kubectl_local[@]}" get "$resource" --namespace devops >/dev/null 2>&1; then
    resources+=("$resource")
  fi
done

patch_failed=0
for resource in "${resources[@]}"; do
  if ! "${kubectl_local[@]}" patch "$resource" \
    --namespace devops \
    --type=merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/woodpecker-secret-version\":\"${secret_version}\"}}}}}" \
    >/dev/null; then
    printf 'failed to update Woodpecker Secret version on %s\n' "$resource" >&2
    patch_failed=1
  fi
done
if [[ "$patch_failed" -ne 0 ]]; then
  exit 1
fi

rollout_failed=0
for resource in "${resources[@]}"; do
  if ! "${kubectl_local[@]}" rollout status "$resource" --namespace devops --timeout=120s; then
    printf 'Woodpecker rollout did not complete for %s\n' "$resource" >&2
    rollout_failed=1
  fi
done
if [[ "$rollout_failed" -ne 0 ]]; then
  exit 1
fi

echo "Woodpecker Secrets synchronized to local K3s"
