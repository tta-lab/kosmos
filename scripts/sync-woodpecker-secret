#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"

if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo "usage: sync-woodpecker-secret [--validate-only] ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == "-" ]]; then
  env_file=/dev/stdin
elif [[ ! -s "$env_file" ]]; then
  printf 'missing or empty Woodpecker environment file: %s\n' "$env_file" >&2
  exit 1
fi

required_keys=(
  WOODPECKER_AGENT_SECRET
  WOODPECKER_FORGEJO_CLIENT
  WOODPECKER_FORGEJO_SECRET
)
declare -A seen_keys=()
declare -A invalid_keys=()

while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  case "$key" in
    WOODPECKER_AGENT_SECRET|WOODPECKER_FORGEJO_CLIENT|WOODPECKER_FORGEJO_SECRET)
      if [[ -n "${seen_keys[$key]+present}" || -z "$value" ]]; then
        invalid_keys[$key]=1
      fi
      seen_keys[$key]=1
      ;;
  esac
done <"$env_file"

validation_failed=0
for key in "${required_keys[@]}"; do
  if [[ -z "${seen_keys[$key]+present}" || -n "${invalid_keys[$key]+invalid}" ]]; then
    printf 'missing, empty, or duplicate required key: %s\n' "$key" >&2
    validation_failed=1
  fi
done
if [[ "$validation_failed" -ne 0 ]]; then
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo "Woodpecker environment validation passed"
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace devops --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

{
  "${kubectl_local[@]}" create secret generic woodpecker-server-env \
    --namespace devops \
    --from-env-file="$env_file" \
    --dry-run=client \
    -o yaml
} | "${kubectl_local[@]}" apply -f - >/dev/null

secret_version="$(
  "${kubectl_local[@]}" get secret woodpecker-server-env \
    --namespace devops \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$secret_version" ]]; then
  echo "Woodpecker Secret has no resourceVersion" >&2
  exit 1
fi

resources=()
for resource in deployment/woodpecker statefulset/woodpecker-agent; do
  if "${kubectl_local[@]}" get "$resource" --namespace devops >/dev/null 2>&1; then
    resources+=("$resource")
  fi
done

patch_failed=0
for resource in "${resources[@]}"; do
  if ! "${kubectl_local[@]}" patch "$resource" \
    --namespace devops \
    --type=merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/woodpecker-secret-version\":\"${secret_version}\"}}}}}" \
    >/dev/null; then
    printf 'failed to update Woodpecker Secret version on %s\n' "$resource" >&2
    patch_failed=1
  fi
done
if [[ "$patch_failed" -ne 0 ]]; then
  exit 1
fi

rollout_failed=0
for resource in "${resources[@]}"; do
  if ! "${kubectl_local[@]}" rollout status "$resource" --namespace devops --timeout=120s; then
    printf 'Woodpecker rollout did not complete for %s\n' "$resource" >&2
    rollout_failed=1
  fi
done
if [[ "$rollout_failed" -ne 0 ]]; then
  exit 1
fi

echo "Woodpecker Secret synchronized to local K3s"
