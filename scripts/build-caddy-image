#!/usr/bin/env bash
set -euo pipefail

load=0
case "${1:-}" in
  --load) load=1; shift ;;
  '') ;;
  *) echo 'usage: build-caddy-image [--load]' >&2; exit 2 ;;
esac
[[ "$#" -eq 0 ]] || { echo 'usage: build-caddy-image [--load]' >&2; exit 2; }
root="$(cd "$(dirname "$0")/.." && pwd)"
image=localhost/kosmos/caddy-cloudflare:2.10.0-cf0.2.4
podman build --network host \
  --build-arg "GOPROXY=${GOPROXY:-https://proxy.golang.org}" \
  --build-arg "GOSUMDB=${GOSUMDB:-sum.golang.org}" \
  --tag "$image" "$root/images/caddy-cloudflare"
podman run --rm --network none "$image" caddy list-modules \
  | rg -x dns.providers.cloudflare
if [[ "$load" -eq 1 ]]; then
  temp="$(mktemp -d)"
  trap 'rm -rf -- "$temp"' EXIT
  podman save --format oci-archive --output "$temp/caddy.tar" "$image"
  sudo -- k3s ctr images import "$temp/caddy.tar"
fi
