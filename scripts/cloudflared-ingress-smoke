#!/usr/bin/env bash
set -euo pipefail

unit="${CLOUDFLARED_TUNNEL_UNIT:-cloudflared-tunnel-kepos.service}"
config_path="${CLOUDFLARED_CONFIG:-}"
url="${CLOUDFLARED_INGRESS_URL:-https://git.guion.io/v2/}"
expected_hostname="${CLOUDFLARED_EXPECTED_HOSTNAME:-git.guion.io}"
expected_service="${CLOUDFLARED_EXPECTED_SERVICE:-http://127.0.0.1:3000}"

usage() {
  cat <<'EOF'
usage: cloudflared-ingress-smoke

Validate the WSL cloudflared ingress config and verify that the Forgejo
hostname routes to the local Forgejo HTTP service.

Environment:
  CLOUDFLARED_TUNNEL_UNIT       systemd tunnel unit. Default: cloudflared-tunnel-kepos.service
  CLOUDFLARED_CONFIG            cloudflared config path. Default: inferred from the systemd unit
  CLOUDFLARED_INGRESS_URL       URL to match. Default: https://git.guion.io/v2/
  CLOUDFLARED_EXPECTED_HOSTNAME Expected matched hostname. Default: git.guion.io
  CLOUDFLARED_EXPECTED_SERVICE  Expected matched service. Default: http://127.0.0.1:3000
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$#" -gt 0 ]]; then
  usage >&2
  exit 2
fi

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

infer_config_path() {
  local exec_start

  exec_start="$(systemctl show "$unit" -p ExecStart --value)"
  sed -n 's/.*--config=\([^ ]*\).*/\1/p' <<<"$exec_start"
}

require cloudflared
require grep
require sed
require systemctl

if [[ -z "$config_path" ]]; then
  config_path="$(infer_config_path)"
fi

if [[ -z "$config_path" ]]; then
  printf 'could not infer cloudflared config path from %s\n' "$unit" >&2
  exit 1
fi

if [[ ! -s "$config_path" ]]; then
  printf 'missing or empty cloudflared config: %s\n' "$config_path" >&2
  exit 1
fi

cloudflared tunnel --config "$config_path" ingress validate >/dev/null

rule_output="$(cloudflared tunnel --config "$config_path" ingress rule "$url")"

if ! grep -qx $'\thostname: '"$expected_hostname" <<<"$rule_output"; then
  printf 'cloudflared ingress for %s did not match hostname %s\n' "$url" "$expected_hostname" >&2
  printf '%s\n' "$rule_output" >&2
  exit 1
fi

if ! grep -qx $'\tservice: '"$expected_service" <<<"$rule_output"; then
  printf 'cloudflared ingress for %s did not route to %s\n' "$url" "$expected_service" >&2
  printf '%s\n' "$rule_output" >&2
  exit 1
fi

printf 'Cloudflared ingress smoke passed: %s -> %s via %s\n' "$url" "$expected_service" "$config_path"
