#!/usr/bin/env bash
set -euo pipefail

kubeconfig="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace ebooks --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

secret_dir="$(mktemp -d)"
trap 'rm -rf "$secret_dir"' EXIT
chmod 700 "$secret_dir"

if "${kubectl_local[@]}" get secret bookorbit-env --namespace ebooks >/dev/null 2>&1; then
  echo 'Kept existing BookOrbit credentials'
else
  umask 077
  printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 32)" >"$secret_dir/bookorbit.env"
  printf 'JWT_SECRET=%s\n' "$(openssl rand -hex 32)" >>"$secret_dir/bookorbit.env"
  printf 'SETUP_BOOTSTRAP_TOKEN=%s\n' "$(openssl rand -hex 32)" >>"$secret_dir/bookorbit.env"
  "${kubectl_local[@]}" create secret generic bookorbit-env \
    --namespace ebooks \
    --from-env-file="$secret_dir/bookorbit.env" \
    --dry-run=client \
    -o yaml \
    | "${kubectl_local[@]}" apply -f - >/dev/null
  echo 'Created BookOrbit credentials'
fi
