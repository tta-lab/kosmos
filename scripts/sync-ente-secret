#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"

if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo "usage: sync-ente-secret [--validate-only] ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == "-" ]]; then
  env_file=/dev/stdin
elif [[ ! -s "$env_file" ]]; then
  printf 'missing or empty Ente environment file: %s\n' "$env_file" >&2
  exit 1
fi

required_keys=(
  POSTGRES_PASSWORD
  ENTE_KEY_ENCRYPTION
  ENTE_KEY_HASH
  ENTE_JWT_SECRET
  GARAGE_RPC_SECRET
  GARAGE_ACCESS_KEY
  GARAGE_SECRET_KEY
)
declare -A allowed_keys=()
declare -A seen_keys=()
declare -A invalid_keys=()

for key in "${required_keys[@]}"; do
  allowed_keys[$key]=1
done

while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  if [[ -z "${allowed_keys[$key]+present}" ]]; then
    printf 'unexpected key in Ente environment: %s\n' "$key" >&2
    invalid_keys[$key]=1
    continue
  fi

  if [[ -n "${seen_keys[$key]+present}" || -z "$value" ]]; then
    invalid_keys[$key]=1
  fi
  seen_keys[$key]=1
done <"$env_file"

validation_failed=0
for key in "${required_keys[@]}"; do
  if [[ -z "${seen_keys[$key]+present}" || -n "${invalid_keys[$key]+invalid}" ]]; then
    printf 'missing, empty, or duplicate required key: %s\n' "$key" >&2
    validation_failed=1
  fi
done
if [[ "${#invalid_keys[@]}" -ne 0 ]]; then
  validation_failed=1
fi
if [[ "$validation_failed" -ne 0 ]]; then
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo "Ente environment validation passed"
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace photos --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

{
  "${kubectl_local[@]}" create secret generic ente-stack-env \
    --namespace photos \
    --from-env-file="$env_file" \
    --dry-run=client \
    -o yaml
} | "${kubectl_local[@]}" apply -f - >/dev/null

secret_version="$(
  "${kubectl_local[@]}" get secret ente-stack-env \
    --namespace photos \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$secret_version" ]]; then
  echo "Ente Secret has no resourceVersion" >&2
  exit 1
fi

resources=()
for resource in deployment/museum statefulset/postgres statefulset/garage; do
  if "${kubectl_local[@]}" get "$resource" --namespace photos >/dev/null 2>&1; then
    resources+=("$resource")
  fi
done

for resource in "${resources[@]}"; do
  "${kubectl_local[@]}" patch "$resource" \
    --namespace photos \
    --type=merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/ente-secret-version\":\"${secret_version}\"}}}}}" \
    >/dev/null
done

rollout_failed=0
for resource in "${resources[@]}"; do
  if ! "${kubectl_local[@]}" rollout status "$resource" --namespace photos --timeout=180s; then
    printf 'rollout did not complete for %s\n' "$resource" >&2
    rollout_failed=1
  fi
done
if [[ "$rollout_failed" -ne 0 ]]; then
  exit 1
fi

echo "Ente Secret synchronized to local K3s"
