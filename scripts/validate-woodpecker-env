#!/usr/bin/env bash
set -euo pipefail

server_env_file="${1:-}"
postgres_env_file="${2:-}"
if [[ -z "$server_env_file" || -z "$postgres_env_file" || "$#" -ne 2 ]]; then
  echo 'usage: validate-woodpecker-env SERVER_ENV_FILE POSTGRES_ENV_FILE' >&2
  exit 2
fi
if [[ "$server_env_file" == "-" ]]; then
  server_env_file=/dev/stdin
fi

validate_env_file() {
  local env_file="$1"
  local label="$2"
  shift 2
  local required_key
  local key
  local value
  local validation_failed=0
  local required_keys=("$@")
  declare -A seen_keys=()
  declare -A invalid_keys=()

  if [[ ! -r "$env_file" ]]; then
    printf 'missing or unreadable Woodpecker %s environment file: %s\n' "$label" "$env_file" >&2
    return 1
  fi

  while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
    for required_key in "${required_keys[@]}"; do
      if [[ "$key" == "$required_key" ]]; then
        if [[ -n "${seen_keys[$key]+present}" || -z "$value" ]]; then
          invalid_keys[$key]=1
        fi
        seen_keys[$key]=1
        break
      fi
    done
  done <"$env_file"

  for required_key in "${required_keys[@]}"; do
    if [[ -z "${seen_keys[$required_key]+present}" || -n "${invalid_keys[$required_key]+invalid}" ]]; then
      printf 'missing, empty, or duplicate required key in %s environment: %s\n' "$label" "$required_key" >&2
      validation_failed=1
    fi
  done

  return "$validation_failed"
}

validate_env_file "$server_env_file" server \
  WOODPECKER_AGENT_SECRET \
  WOODPECKER_FORGEJO_CLIENT \
  WOODPECKER_FORGEJO_SECRET
validate_env_file "$postgres_env_file" PostgreSQL \
  POSTGRES_PASSWORD \
  WOODPECKER_DATABASE_DATASOURCE

echo "Woodpecker environment validation passed"
