#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == "--validate-only" ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"
if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo "usage: sync-hindsight-secret [--validate-only] ENV_FILE" >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == "-" ]]; then
  env_file=/dev/stdin
elif [[ ! -s "$env_file" ]]; then
  printf 'missing or empty Hindsight environment file: %s\n' "$env_file" >&2
  exit 1
fi

required_key="HINDSIGHT_API_LLM_API_KEY"
line_count=0
api_key=""
while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  if [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]]; then
    continue
  fi
  line_count=$((line_count + 1))
  if [[ "$key" != "$required_key" ]]; then
    echo "Hindsight environment contains an unexpected entry" >&2
    exit 1
  fi
  api_key="$value"
done <"$env_file"

if [[ "$line_count" -ne 1 || -z "$api_key" ]]; then
  echo "Hindsight environment must contain exactly one non-empty required entry" >&2
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo "Hindsight environment validation passed"
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace hindsight --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

"${kubectl_local[@]}" create secret generic hindsight-env \
  --namespace hindsight \
  --from-env-file="$env_file" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

secret_version="$(
  "${kubectl_local[@]}" get secret hindsight-env \
    --namespace hindsight \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$secret_version" ]]; then
  echo "Hindsight Secret has no resourceVersion" >&2
  exit 1
fi

if "${kubectl_local[@]}" get deployment/hindsight --namespace hindsight >/dev/null 2>&1; then
  "${kubectl_local[@]}" patch deployment/hindsight \
    --namespace hindsight \
    --type=merge \
    --patch "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"kosmos.tta-lab.org/hindsight-secret-version\":\"${secret_version}\"}}}}}" \
    >/dev/null
  if ! "${kubectl_local[@]}" rollout status deployment/hindsight \
    --namespace hindsight \
    --timeout=600s; then
    echo "rollout did not complete for deployment/hindsight" >&2
    exit 1
  fi
fi

echo "Hindsight Secret synchronized to local K3s"
