#!/usr/bin/env bash
set -euo pipefail

kubeconfig="/etc/rancher/k3s/k3s.yaml"
expected_server="https://127.0.0.1:26443"
kubectl_local=(kubectl --kubeconfig "$kubeconfig")
validate_only=0

if [[ "${1:-}" == '--validate-only' ]]; then
  validate_only=1
  shift
fi

env_file="${1:-}"
if [[ -z "$env_file" || "$#" -ne 1 ]]; then
  echo 'usage: sync-forgejo-r2-backup-secret [--validate-only] ENV_FILE' >&2
  exit 2
fi

if [[ "$validate_only" -eq 1 && "$env_file" == '-' ]]; then
  env_file=/dev/stdin
elif [[ ! -r "$env_file" ]]; then
  printf 'missing or unreadable Forgejo R2 backup environment file: %s\n' "$env_file" >&2
  exit 1
fi

required_keys=(
  AWS_ACCESS_KEY_ID
  AWS_SECRET_ACCESS_KEY
  RESTIC_PASSWORD
  RESTIC_REPOSITORY
)
declare -A allowed_keys=()
declare -A seen_keys=()
declare -A invalid_keys=()
repository_value=''
validation_failed=0
for key in "${required_keys[@]}"; do
  allowed_keys[$key]=1
done

while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  if [[ -z "$key" ]]; then
    continue
  fi
  if [[ -z "${allowed_keys[$key]+present}" ]]; then
    printf 'unexpected key in Forgejo R2 backup environment: %s\n' "$key" >&2
    invalid_keys[$key]=1
    validation_failed=1
    continue
  fi

  if [[ -n "${seen_keys[$key]+present}" || -z "$value" ]]; then
    invalid_keys[$key]=1
  fi
  seen_keys[$key]=1
  if [[ "$key" == RESTIC_REPOSITORY ]]; then
    repository_value="$value"
  fi
done <"$env_file"

for key in "${required_keys[@]}"; do
  if [[ -z "${seen_keys[$key]+present}" || -n "${invalid_keys[$key]+invalid}" ]]; then
    printf 'missing, empty, or duplicate required key: %s\n' "$key" >&2
    validation_failed=1
  fi
done

# Keep the repository location constrained to restic's S3 backend. The
# endpoint and bucket remain operator-provided secret material and are never
# echoed by this synchronizer.
if [[ -n "$repository_value" && "$repository_value" != s3:* ]]; then
  echo 'RESTIC_REPOSITORY must use restic s3: syntax' >&2
  validation_failed=1
fi

if [[ "$validation_failed" -ne 0 ]]; then
  exit 1
fi

if [[ "$validate_only" -eq 1 ]]; then
  echo 'Forgejo R2 backup environment validation passed'
  exit 0
fi

actual_server="$("${kubectl_local[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  printf 'refusing non-local cluster: %s\n' "$actual_server" >&2
  exit 1
fi

"${kubectl_local[@]}" create namespace devops --dry-run=client -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

"${kubectl_local[@]}" create secret generic forgejo-r2-backup \
  --namespace devops \
  --from-env-file="$env_file" \
  --dry-run=client \
  -o yaml \
  | "${kubectl_local[@]}" apply -f - >/dev/null

secret_version="$(
  "${kubectl_local[@]}" get secret forgejo-r2-backup \
    --namespace devops \
    -o jsonpath='{.metadata.resourceVersion}'
)"
if [[ -z "$secret_version" ]]; then
  echo 'Forgejo R2 backup Secret has no resourceVersion' >&2
  exit 1
fi

echo 'Forgejo R2 backup Secret synchronized to local K3s'
