#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:?KOSMOS_REPO_ROOT is required}"
packages="$repo_root/modules/common/packages.nix"

awk '
  /# Secrets and task helpers/ { in_section = 1 }
  /# Languages/ { in_section = 0 }
  in_section && $1 == "openssl" { found = 1 }
  END { exit !found }
' "$packages"
