#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT
mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf 'kubectl %s\n' "$*" >>"$TEST_EVENTS_LOG"
case "$*" in
  "config view "*|*" config view "*)
    printf '%s' "$TEST_KUBE_SERVER"
    ;;
  *"scale deployment/hindsight -n hindsight --replicas=1")
    ;;
  *"wait --for=condition=Available deployment/hindsight -n hindsight --timeout=300s")
    ;;
  *"patch service/hindsight -n hindsight --type=json "*)
    if grep -F 'kosmos.tta-lab.org/role' <<<"$*" >/dev/null; then
      echo 'rollback patch retained a role selector' >&2
      exit 1
    fi
    grep -F '"op":"replace"' <<<"$*" >/dev/null
    grep -F '"path":"/spec/selector"' <<<"$*" >/dev/null
    grep -F '"app.kubernetes.io/name":"hindsight"' <<<"$*" >/dev/null
    grep -F '"app.kubernetes.io/part-of":"kosmos-hindsight"' <<<"$*" >/dev/null
    ;;
  *"get service/hindsight -n hindsight -o json")
    printf '%s\n' '{"spec":{"selector":{"app.kubernetes.io/name":"hindsight","app.kubernetes.io/part-of":"kosmos-hindsight"}}}'
    ;;
  *"scale deployment/hindsight-multilingual -n hindsight --replicas=0")
    ;;
  *)
    printf 'unexpected kubectl invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

cat >"$test_root/bin/curl" <<'EOF'
#!@bash@
set -euo pipefail
printf 'curl %s\n' "$*" >>"$TEST_EVENTS_LOG"
[[ "${TEST_CURL_FAIL:-0}" != 1 ]]
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/curl"
chmod +x "$test_root/bin/curl"

export PATH="$test_root/bin:$PATH"
export KUBECONFIG="$test_root/kubeconfig"
export TEST_EVENTS_LOG="$test_root/events.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"

KOSMOS_REPO_ROOT="$repo_root" just --justfile "$repo_root/justfile" hindsight-rollback >"$test_root/success-output"
grep -F 'kubectl scale deployment/hindsight -n hindsight --replicas=1' "$TEST_EVENTS_LOG" >/dev/null
grep -F 'kubectl wait --for=condition=Available deployment/hindsight -n hindsight --timeout=300s' "$TEST_EVENTS_LOG" >/dev/null
grep -F 'kubectl patch service/hindsight -n hindsight --type=json' "$TEST_EVENTS_LOG" >/dev/null
grep -F 'curl --fail --silent --show-error --max-time 10 --noproxy * http://hindsight.localhost:17480/health' "$TEST_EVENTS_LOG" >/dev/null
grep -F 'kubectl scale deployment/hindsight-multilingual -n hindsight --replicas=0' "$TEST_EVENTS_LOG" >/dev/null
scale_line="$(grep -n 'kubectl scale deployment/hindsight -n hindsight --replicas=1' "$TEST_EVENTS_LOG" | cut -d: -f1)"
wait_line="$(grep -n 'kubectl wait --for=condition=Available deployment/hindsight ' "$TEST_EVENTS_LOG" | cut -d: -f1)"
patch_line="$(grep -n 'kubectl patch service/hindsight ' "$TEST_EVENTS_LOG" | cut -d: -f1)"
health_line="$(grep -n '^curl ' "$TEST_EVENTS_LOG" | cut -d: -f1)"
multilingual_line="$(grep -n 'kubectl scale deployment/hindsight-multilingual ' "$TEST_EVENTS_LOG" | cut -d: -f1)"
(( scale_line < wait_line && wait_line < patch_line && patch_line < health_line && health_line < multilingual_line ))

: >"$TEST_EVENTS_LOG"
export TEST_CURL_FAIL=1
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
if KOSMOS_REPO_ROOT="$repo_root" just --justfile "$repo_root/justfile" hindsight-rollback >"$test_root/health-failure-output" 2>&1; then
  echo 'rollback target ignored canonical health failure' >&2
  exit 1
fi
if grep -F 'scale deployment/hindsight-multilingual' "$TEST_EVENTS_LOG" >/dev/null; then
  echo 'rollback target scaled multilingual before canonical health passed' >&2
  exit 1
fi

: >"$TEST_EVENTS_LOG"
export TEST_CURL_FAIL=0
export TEST_KUBE_SERVER="https://remote.example.invalid"
if KOSMOS_REPO_ROOT="$repo_root" just --justfile "$repo_root/justfile" hindsight-rollback >"$test_root/remote-output" 2>&1; then
  echo 'rollback target accepted a non-local cluster' >&2
  exit 1
fi
grep -F 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output" >/dev/null
[[ "$(wc -l <"$TEST_EVENTS_LOG")" -eq 1 ]]

printf 'Hindsight rollback target is guarded, ordered, selector-exact, health-verified, and failure-safe\n'
