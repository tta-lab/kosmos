#!/usr/bin/env python3
"""Exercise address selection and credential rendering with test-owned fixtures."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]


def address(value, **flags):
    return dict(family="inet6", scope="global", local=value, **flags)


class PublicDdnsTest(unittest.TestCase):
    def select(self, entries, interface="eth1"):
        return subprocess.run(
            [sys.executable, ROOT / "scripts/select-ddns-ipv6"],
            input=json.dumps([dict(ifname=interface, addr_info=entries)]),
            text=True, capture_output=True,
        )

    def test_prefix_rotation_ignores_old_and_privacy_addresses(self):
        result = self.select([
            address("240e:393:331c:f480::8", preferred_life_time=0),
            address("240e:393:331c:f481::8"),
            address("240e:393:331c:f481:75bb:482c:53d1:7444"),
        ])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.strip(), "240e:393:331c:f481::8")

    def test_no_publishable_address_fails_without_output(self):
        cases = [[], [address("fd00::8")], [address("240e::9")],
                 [address("240e::8"), address("240f::8")]]
        for flag in ("temporary", "deprecated", "tentative", "dadfailed"):
            cases.append([address("240e::8", **{flag: True})])
        for entries in cases:
            with self.subTest(entries=entries):
                result = self.select(entries)
                self.assertNotEqual(result.returncode, 0)
                self.assertEqual(result.stdout, "")
        self.assertNotEqual(self.select([address("240e::8")], "eth0").returncode, 0)

    def test_private_runtime_config(self):
        with tempfile.TemporaryDirectory() as directory:
            token = Path(directory) / "token"
            output = Path(directory) / "config.json"
            token.write_text("fixture-token\n")
            output.touch(mode=0o644)
            result = subprocess.run([
                sys.executable, ROOT / "scripts/prepare-ddns-config",
                token, "/fixture/select-address", output,
            ], capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertNotIn("fixture-token", result.stdout + result.stderr)
            self.assertEqual(output.stat().st_mode & 0o777, 0o600)
            conf = json.loads(output.read_text())["dnsconf"][0]
            self.assertFalse(conf["ipv4"]["enable"])
            self.assertEqual(conf["ipv6"]["cmd"], "/fixture/select-address")
            self.assertEqual(conf["ipv6"]["domains"], ["ddns-smoke.guion.io?proxied=false"])
            self.assertEqual(conf["dns"]["secret"], "fixture-token")
            token.write_text("")
            output.unlink()
            result = subprocess.run([
                sys.executable, ROOT / "scripts/prepare-ddns-config",
                token, "/fixture/select-address", output,
            ], capture_output=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertFalse(output.exists())


if __name__ == "__main__":
    unittest.main()
