#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

tk show --dangerous-allow-redirect "$repo_root/tanka/environments/clipcascade" \
  | yq -s '.' >"$test_root/clipcascade.json"

jq -e '
  . as $resources |
  def resource($kind; $name):
    $resources | map(select(.kind == $kind and .metadata.name == $name)) | first;

  (resource("Namespace"; "clipcascade").metadata.name == "clipcascade") and
  (resource("Deployment"; "clipcascade").spec.replicas == 1) and
  (resource("Deployment"; "clipcascade").spec.strategy.type == "Recreate") and
  (resource("Deployment"; "clipcascade").spec.template.spec.containers[0] as $container |
    ($container.image == "localhost/kosmos/clipcascade:faf6ac06") and
    ($container.imagePullPolicy == "Never") and
    ($container.startupProbe.httpGet.path == "/health") and
    ($container.readinessProbe.httpGet.path == "/health") and
    ($container.livenessProbe.httpGet.path == "/health") and
    ($container.securityContext.runAsNonRoot == true) and
    ($container.securityContext.runAsUser == 10001) and
    ($container.env | any(.name == "CC_P2P_ENABLED" and .value == "false")) and
    ($container.env | any(.name == "CC_ALLOWED_ORIGINS" and .value == "http://clipcascade.localhost:17480")) and
    ($container.env | any(.name == "CC_SERVER_DB_PASSWORD" and .valueFrom.secretKeyRef.name == "clipcascade-database")) and
    ($container.volumeMounts | any(.mountPath == "/database" and .name == "database")) and
    ($container.volumeMounts | any(.mountPath == "/app/logs" and .name == "logs")) and
    ($container.volumeMounts | any(.mountPath == "/tmp" and .name == "tmp"))
  ) and
  (resource("Service"; "clipcascade").spec.type == "ClusterIP") and
  (resource("Service"; "clipcascade").spec.ports[0].port == 8080) and
  (resource("PersistentVolume"; "kosmos-clipcascade").spec.persistentVolumeReclaimPolicy == "Retain") and
  (resource("PersistentVolume"; "kosmos-clipcascade").spec.hostPath.path == "/var/lib/kosmos-k3s/clipcascade") and
  (resource("PersistentVolumeClaim"; "clipcascade-data").spec.volumeName == "kosmos-clipcascade") and
  (map(select(.kind == "Secret")) | length == 0)
' "$test_root/clipcascade.json" >/dev/null

printf 'ClipCascade manifests expose a hardened P2S service with retained H2 storage\n'
