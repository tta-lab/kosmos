#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
script="$repo_root/scripts/ttal-wezterm-projects"
wezterm_config="$repo_root/wezterm/macos-client.lua"
wezterm_server_config="$repo_root/wezterm/wsl-server.lua"
wezterm_doc="$repo_root/docs/wezterm-wsl-mux.md"
packages="$repo_root/modules/common/packages.nix"
configs="$repo_root/modules/configs.nix"
tta_lab_package="$repo_root/packages/tta-lab/default.nix"

projects_json="$(
  jq -n \
    --arg repo_root "$repo_root" \
    '[
      {"alias":"ko","name":"kosmos","path":$repo_root},
      {"alias":"fb.ai","name":"Ai Workflow Processor","path":$repo_root},
      {"alias":"missing","name":"Missing Project","path":"/tmp/kosmos-ttal-wezterm-missing-project"}
    ]'
)"

output="$(
  TTAL_WEZTERM_PROJECTS_JSON="$projects_json" \
  bash "$script" --choices
)"

expected="$(
  cat <<EOF
[
  {
    "id": "ko\t$repo_root",
    "label": "ko  kosmos  $repo_root"
  },
  {
    "id": "fb.ai\t$repo_root",
    "label": "fb.ai  Ai Workflow Processor  $repo_root"
  }
]
EOF
)"

if [[ "$output" != "$expected" ]]; then
  printf 'unexpected choices output\nexpected:\n%s\nactual:\n%s\n' "$expected" "$output" >&2
  exit 1
fi

if grep -Fq 'missing' <<<"$output"; then
  printf 'missing project paths should not appear in WezTerm picker choices\n' >&2
  exit 1
fi

if grep -Fq 'pkgsUnstable.wezterm' "$packages"; then
  printf 'WSL packages should not include the wezterm binary\n' >&2
  exit 1
fi

if ! grep -Fq 'wezterm.terminfo' "$packages"; then
  printf 'WSL packages should include wezterm terminfo\n' >&2
  exit 1
fi

if ! grep -Fq 'ttaLab.ttalWeztermProjects' "$packages"; then
  printf 'WSL packages should include ttal-wezterm-projects\n' >&2
  exit 1
fi

if ! grep -Fq 'ttalWeztermProjects' "$tta_lab_package"; then
  printf 'tta-lab package set should expose ttalWeztermProjects\n' >&2
  exit 1
fi

if ! grep -Fq 'remote_wezterm_path = "/run/current-system/sw/bin/wezterm"' "$wezterm_config"; then
  printf 'Mac WezTerm config should point SSH mux to the WSL wezterm binary\n' >&2
  exit 1
fi

if ! grep -Fq "act.SwitchToWorkspace" "$wezterm_config"; then
  printf 'Mac WezTerm config should switch/create WezTerm workspaces\n' >&2
  exit 1
fi

if ! grep -Fq '"ssh", ssh_host, "ttal-wezterm-projects", "--choices"' "$wezterm_config"; then
  printf 'Mac WezTerm config should load project choices through SSH\n' >&2
  exit 1
fi

if ! grep -Fq 'choices_cache_ttl_seconds = 3600' "$wezterm_config"; then
  printf 'Mac WezTerm config should cache project choices briefly\n' >&2
  exit 1
fi

if ! grep -Fq 'choose_project(window, pane, true)' "$wezterm_config"; then
  printf 'Mac WezTerm config should support forced project picker refresh\n' >&2
  exit 1
fi

if ! grep -Fq 'set_environment_variables = wsl_spawn_env' "$wezterm_config"; then
  printf 'Mac WezTerm config should set WSL env on remote project spawns\n' >&2
  exit 1
fi

if ! grep -Fq 'HOME = "/home/neil"' "$wezterm_config"; then
  printf 'Mac WezTerm config should prevent macOS HOME from leaking into WSL fish\n' >&2
  exit 1
fi

if ! grep -Fq 'TMPDIR = "/tmp"' "$wezterm_config"; then
  printf 'Mac WezTerm config should prevent macOS TMPDIR from leaking into WSL fish\n' >&2
  exit 1
fi

if ! grep -Fq 'set_environment_variables = {' "$wezterm_server_config"; then
  printf 'WSL server WezTerm config should set WSL-local environment defaults\n' >&2
  exit 1
fi

if ! grep -Fq 'TMPDIR = "/tmp"' "$wezterm_server_config"; then
  printf 'WSL server WezTerm config should set a Linux temp directory for new panes\n' >&2
  exit 1
fi

if ! grep -Fq 'pcall(wezterm.json_parse, stdout)' "$wezterm_config"; then
  printf 'Mac WezTerm config should guard JSON parsing with pcall\n' >&2
  exit 1
fi

if ! grep -Fq 'wezterm connect kosmos-wsl' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should show how to connect\n' >&2
  exit 1
fi

if ! grep -Fq 'Host kosmos-wsl' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should show the SSH host shape\n' >&2
  exit 1
fi

if ! grep -Fq 'or "kosmos-wsl"' "$wezterm_config"; then
  printf 'Mac WezTerm config should default to the kosmos-wsl SSH alias\n' >&2
  exit 1
fi

if ! grep -Fq 'wezterm/macos-client.lua' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should point at the macOS client config template\n' >&2
  exit 1
fi

if [[ ! -f "$wezterm_server_config" ]]; then
  printf 'WSL server-side WezTerm config should exist\n' >&2
  exit 1
fi

if ! grep -Fq 'wezterm/wsl-server.lua' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should point at the WSL server config\n' >&2
  exit 1
fi

if ! grep -Fq '"wezterm/wezterm.lua".source = ../wezterm/wsl-server.lua;' "$configs"; then
  printf 'Home Manager should install the WSL server WezTerm config\n' >&2
  exit 1
fi

if ! grep -Fq 'The SSH alias and WezTerm domain name default to the same string' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain SSH alias versus domain name\n' >&2
  exit 1
fi

if ! grep -Fq 'wezterm-mux-server --daemonize' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain first-connect mux startup logs\n' >&2
  exit 1
fi

if ! grep -Fq 'Workspace names use exact TTAL aliases' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain workspace alias naming\n' >&2
  exit 1
fi

if ! grep -Fq 'Projects whose paths do not exist on WSL are skipped' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain stale path filtering\n' >&2
  exit 1
fi

if ! grep -Fq 'The picker caches project choices for one hour' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain project picker caching\n' >&2
  exit 1
fi

if ! grep -Fq 'The client config sets WSL HOME, XDG, and temp paths' "$wezterm_doc"; then
  printf 'WezTerm WSL mux doc should explain WSL spawn environment\n' >&2
  exit 1
fi
