#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace cloudreve "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" get secret cloudreve-env "* ]]; then
  if [[ "$*" == *"resourceVersion"* ]]; then
    printf '%s' "$TEST_SECRET_VERSION"
  else
    [[ "$TEST_SECRET_PRESENT" == 1 ]]
    if [[ "$*" == *"POSTGRES_PASSWORD"* ]]; then
      printf '%s' "$TEST_LIVE_PASSWORD"
    elif [[ "$*" == *"jsonpath"* ]]; then
      [[ "$*" == *"jsonpath={.data.conf\\.ini}"* ]]
      printf '%s' "$TEST_LIVE_CONF"
    fi
  fi
elif [[ "$*" == *" create secret generic cloudreve-env "* ]]; then
  password_file=""
  config_file=""
  for argument in "$@"; do
    case "$argument" in
      --from-file=POSTGRES_PASSWORD=*) password_file="${argument#--from-file=POSTGRES_PASSWORD=}" ;;
      --from-file=conf.ini=*) config_file="${argument#--from-file=conf.ini=}" ;;
    esac
  done
  [[ -n "$password_file" && -n "$config_file" ]]
  grep -qx "$TEST_POSTGRES_PASSWORD" "$password_file"
  grep -q '^\[System\]$' "$config_file"
  grep -qx "SessionSecret = $TEST_SESSION_SECRET" "$config_file"
  grep -q '^\[Database\]$' "$config_file"
  grep -qx "Password = $TEST_POSTGRES_PASSWORD" "$config_file"
  grep -q '^\[Redis\]$' "$config_file"
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f "* ]]; then
  manifest_path="${!#}"
  if [[ "$manifest_path" == "-" ]]; then
    manifest="$(cat)"
  else
    manifest="$(<"$manifest_path")"
  fi
  [[ "$manifest" == *"apiVersion: v1"* ]]
elif [[ "$*" == *" get statefulset/cloudreve-postgres "* ]]; then
  [[ "$TEST_POSTGRES_EXISTS" == 1 ]]
elif [[ "$*" == *" rollout status statefulset/cloudreve-postgres "* ]]; then
  exit 0
elif [[ "$*" == *" exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql "* ]]; then
  statement="$(cat)"
  [[ "$statement" == "ALTER USER cloudreve PASSWORD '$TEST_POSTGRES_PASSWORD';" ]]
  if [[ "$TEST_FAIL_POSTGRES_EXEC" == 1 ]]; then
    exit 1
  fi

elif [[ "$*" == *" get deployment/cloudreve "* ]]; then
  [[ "$TEST_DEPLOYMENT_EXISTS" == 1 ]]
  if [[ "$*" == *"jsonpath"* ]]; then
    printf '%s' "$TEST_DEPLOYMENT_SECRET_VERSION"
  fi
elif [[ "$*" == *" patch deployment/cloudreve "* ]]; then
  patch=""
  expect_patch_value=0
  for argument in "$@"; do
    if [[ "$expect_patch_value" -eq 1 ]]; then
      patch="$argument"
      break
    fi
    if [[ "$argument" == "--patch" ]]; then
      expect_patch_value=1
    fi
  done
  [[ -n "$patch" ]]
  jq -e --arg version "$TEST_SECRET_VERSION" \
    '.spec.template.metadata.annotations["kosmos.tta-lab.org/cloudreve-secret-version"] == $version' \
    <<<"$patch" >/dev/null
elif [[ "$*" == *" rollout status deployment/cloudreve "* ]]; then
  [[ "$TEST_FAIL_DEPLOYMENT_ROLLOUT" != 1 ]]
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

printf -v postgres_password 'a%.0s' {1..64}
printf -v session_secret 'b%.0s' {1..128}
printf -v rotated_postgres_password 'c%.0s' {1..64}
printf -v rotated_session_secret 'd%.0s' {1..128}
printf -v application_session_secret 'e%.0s' {1..128}

printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" >"$test_root/cloudreve.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$rotated_postgres_password" \
  "SESSION_SECRET=$rotated_session_secret" >"$test_root/rotated.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$rotated_postgres_password" \
  "SESSION_SECRET=$application_session_secret" >"$test_root/application-rotation.env"
printf '%s\n' "$rotated_postgres_password" >"$test_root/rotated-POSTGRES_PASSWORD"

printf '%s\n' "$postgres_password" >"$test_root/POSTGRES_PASSWORD"
printf '%s\n' "POSTGRES_PASSWORD=$postgres_password" >"$test_root/missing-session.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" \
  'EXTRA=value' >"$test_root/extra.env"
printf '%s\n' \
  'POSTGRES_PASSWORD=short' \
  "SESSION_SECRET=$session_secret" >"$test_root/invalid-password.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" \
  "SESSION_SECRET=$session_secret" >"$test_root/duplicate.env"

cat >"$test_root/conf.ini" <<EOF
[System]
Mode = master
Listen = :5212
SessionSecret = $session_secret
ProxyHeader = X-Forwarded-For

[Database]
Type = postgres
Port = 5432
User = cloudreve
Password = $postgres_password
Host = cloudreve-postgres
Name = cloudreve

[Redis]
Server = cloudreve-redis:6379
EOF

cat >"$test_root/rotated-conf.ini" <<EOF
[System]
Mode = master
Listen = :5212
SessionSecret = $rotated_session_secret
ProxyHeader = X-Forwarded-For

[Database]
Type = postgres
Port = 5432
User = cloudreve
Password = $rotated_postgres_password
Host = cloudreve-postgres
Name = cloudreve

[Redis]
Server = cloudreve-redis:6379
EOF

cat >"$test_root/application-rotation-conf.ini" <<EOF
[System]
Mode = master
Listen = :5212
SessionSecret = $application_session_secret
ProxyHeader = X-Forwarded-For

[Database]
Type = postgres
Port = 5432
User = cloudreve
Password = $rotated_postgres_password
Host = cloudreve-postgres
Name = cloudreve

[Redis]
Server = cloudreve-redis:6379
EOF

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_POSTGRES_PASSWORD="$postgres_password"
export TEST_SESSION_SECRET="$session_secret"
export TEST_POSTGRES_EXISTS=1
export TEST_DEPLOYMENT_EXISTS=1
export TEST_SECRET_PRESENT=0
export TEST_LIVE_PASSWORD=""
export TEST_LIVE_CONF=""
export TEST_SECRET_VERSION=91
export TEST_DEPLOYMENT_SECRET_VERSION=""
export TEST_FAIL_POSTGRES_EXEC=0
export TEST_FAIL_DEPLOYMENT_ROLLOUT=0


for invalid_file in missing-session extra invalid-password duplicate; do
  : >"$TEST_KUBECTL_LOG"
  if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/$invalid_file.env" >"$test_root/$invalid_file-output" 2>&1; then
    echo "sync-cloudreve-secret accepted $invalid_file input" >&2
    exit 1
  fi
  [[ ! -s "$TEST_KUBECTL_LOG" ]]
done

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" --validate-only - \
  <"$test_root/cloudreve.env" >"$test_root/validate-output"
grep -q '^Cloudreve environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/initial-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/initial-output"
grep -q -- '--kubeconfig /etc/rancher/k3s/k3s.yaml config view' "$TEST_KUBECTL_LOG"
grep -q 'create namespace cloudreve --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q 'create secret generic cloudreve-env --namespace cloudreve --from-file=POSTGRES_PASSWORD=' "$TEST_KUBECTL_LOG"
grep -q 'rollout status statefulset/cloudreve-postgres --namespace cloudreve --timeout=180s' "$TEST_KUBECTL_LOG"
grep -q 'patch deployment/cloudreve --namespace cloudreve --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s' "$TEST_KUBECTL_LOG"
if grep -q "$postgres_password\|$session_secret" "$test_root/initial-output"; then
  echo 'sync-cloudreve-secret printed secret input' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
export TEST_SECRET_PRESENT=1
TEST_LIVE_PASSWORD="$(base64 -w0 <"$test_root/POSTGRES_PASSWORD")"
TEST_LIVE_CONF="$(base64 -w0 <"$test_root/conf.ini")"
export TEST_LIVE_PASSWORD TEST_LIVE_CONF
export TEST_DEPLOYMENT_SECRET_VERSION=91
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/unchanged-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/unchanged-output"
if grep -qE ' create secret generic cloudreve-env| exec | patch deployment' "$TEST_KUBECTL_LOG"; then
  echo 'sync-cloudreve-secret mutated unchanged Cloudreve credentials' >&2
  exit 1
fi
grep -q 'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s' "$TEST_KUBECTL_LOG"

: >"$TEST_KUBECTL_LOG"
export TEST_POSTGRES_PASSWORD="$rotated_postgres_password"
export TEST_SESSION_SECRET="$rotated_session_secret"
export TEST_SECRET_VERSION=92
export TEST_DEPLOYMENT_SECRET_VERSION=91
export TEST_FAIL_POSTGRES_EXEC=1
if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/rotated.env" >"$test_root/postgres-rotation-failure-output" 2>&1; then
  echo 'sync-cloudreve-secret succeeded despite a PostgreSQL credential update failure' >&2
  exit 1
fi
grep -q 'exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql' "$TEST_KUBECTL_LOG"
if grep -q 'create secret generic cloudreve-env' "$TEST_KUBECTL_LOG"; then
  echo 'sync-cloudreve-secret published a password rotation before PostgreSQL accepted it' >&2
  exit 1
fi

# Model an interrupted synchronization after its Secret write completed.
TEST_LIVE_PASSWORD="$(base64 -w0 <"$test_root/rotated-POSTGRES_PASSWORD")"
TEST_LIVE_CONF="$(base64 -w0 <"$test_root/rotated-conf.ini")"
export TEST_LIVE_PASSWORD TEST_LIVE_CONF
export TEST_FAIL_POSTGRES_EXEC=0
: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/rotated.env" >"$test_root/postgres-rotation-retry-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/postgres-rotation-retry-output"
for expected_command in \
  'exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql' \
  'patch deployment/cloudreve --namespace cloudreve --type=merge' \
  'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s'; do
  if ! grep -q "$expected_command" "$TEST_KUBECTL_LOG"; then
    echo "sync-cloudreve-secret did not recover PostgreSQL credential synchronization: $expected_command" >&2
    exit 1
  fi
done

# The successful retry patched the application template to version 92.
export TEST_DEPLOYMENT_SECRET_VERSION=92
export TEST_SESSION_SECRET="$application_session_secret"
export TEST_SECRET_VERSION=93
export TEST_FAIL_DEPLOYMENT_ROLLOUT=1
: >"$TEST_KUBECTL_LOG"
if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/application-rotation.env" >"$test_root/application-rotation-failure-output" 2>&1; then
  echo 'sync-cloudreve-secret succeeded despite an application rollout failure' >&2
  exit 1
fi
grep -q 'patch deployment/cloudreve --namespace cloudreve --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s' "$TEST_KUBECTL_LOG"

# The Secret and template patch persisted even though the first rollout wait failed.
TEST_LIVE_CONF="$(base64 -w0 <"$test_root/application-rotation-conf.ini")"
export TEST_LIVE_CONF
export TEST_DEPLOYMENT_SECRET_VERSION=93
export TEST_FAIL_DEPLOYMENT_ROLLOUT=0
: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/application-rotation.env" >"$test_root/application-rotation-retry-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/application-rotation-retry-output"
grep -q 'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s' "$TEST_KUBECTL_LOG"
if grep -qE ' exec | patch deployment' "$TEST_KUBECTL_LOG"; then
  echo 'sync-cloudreve-secret mutated already-applied application credentials during rollout recovery' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/remote-output" 2>&1; then
  echo 'sync-cloudreve-secret accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]

printf 'Cloudreve agenix Secret synchronization validates input and recovers interrupted credential changes\n'
