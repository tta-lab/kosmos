#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace cloudreve "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" get secret cloudreve-env "* ]]; then
  if [[ "$*" == *"resourceVersion"* ]]; then
    printf '91'
  else
    [[ "$TEST_SECRET_PRESENT" == 1 ]]
    if [[ "$*" == *"POSTGRES_PASSWORD"* ]]; then
      printf '%s' "$TEST_LIVE_PASSWORD"
    elif [[ "$*" == *"jsonpath"* ]]; then
      [[ "$*" == *"jsonpath={.data.conf\\.ini}"* ]]
      printf '%s' "$TEST_LIVE_CONF"
    fi
  fi
elif [[ "$*" == *" create secret generic cloudreve-env "* ]]; then
  password_file=""
  config_file=""
  for argument in "$@"; do
    case "$argument" in
      --from-file=POSTGRES_PASSWORD=*) password_file="${argument#--from-file=POSTGRES_PASSWORD=}" ;;
      --from-file=conf.ini=*) config_file="${argument#--from-file=conf.ini=}" ;;
    esac
  done
  [[ -n "$password_file" && -n "$config_file" ]]
  grep -qx "$TEST_POSTGRES_PASSWORD" "$password_file"
  grep -q '^\[System\]$' "$config_file"
  grep -qx "SessionSecret = $TEST_SESSION_SECRET" "$config_file"
  grep -q '^\[Database\]$' "$config_file"
  grep -qx "Password = $TEST_POSTGRES_PASSWORD" "$config_file"
  grep -q '^\[Redis\]$' "$config_file"
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f "* ]]; then
  manifest_path="${!#}"
  if [[ "$manifest_path" == "-" ]]; then
    manifest="$(cat)"
  else
    manifest="$(<"$manifest_path")"
  fi
  [[ "$manifest" == *"apiVersion: v1"* ]]
elif [[ "$*" == *" get statefulset/cloudreve-postgres "* ]]; then
  [[ "$TEST_POSTGRES_EXISTS" == 1 ]]
elif [[ "$*" == *" rollout status statefulset/cloudreve-postgres "* ]]; then
  exit 0
elif [[ "$*" == *" exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql "* ]]; then
  statement="$(cat)"
  [[ "$statement" == "ALTER USER cloudreve PASSWORD '$TEST_POSTGRES_PASSWORD';" ]]
elif [[ "$*" == *" get deployment/cloudreve "* ]]; then
  [[ "$TEST_DEPLOYMENT_EXISTS" == 1 ]]
elif [[ "$*" == *" patch deployment/cloudreve "* ]]; then
  [[ "$*" == *"cloudreve-secret-version"* ]]
elif [[ "$*" == *" rollout status deployment/cloudreve "* ]]; then
  exit 0
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

printf -v postgres_password 'a%.0s' {1..64}
printf -v session_secret 'b%.0s' {1..128}
printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" >"$test_root/cloudreve.env"
printf '%s\n' "$postgres_password" >"$test_root/POSTGRES_PASSWORD"
printf '%s\n' "POSTGRES_PASSWORD=$postgres_password" >"$test_root/missing-session.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" \
  'EXTRA=value' >"$test_root/extra.env"
printf '%s\n' \
  'POSTGRES_PASSWORD=short' \
  "SESSION_SECRET=$session_secret" >"$test_root/invalid-password.env"
printf '%s\n' \
  "POSTGRES_PASSWORD=$postgres_password" \
  "SESSION_SECRET=$session_secret" \
  "SESSION_SECRET=$session_secret" >"$test_root/duplicate.env"

cat >"$test_root/conf.ini" <<EOF
[System]
Mode = master
Listen = :5212
SessionSecret = $session_secret
ProxyHeader = X-Forwarded-For

[Database]
Type = postgres
Port = 5432
User = cloudreve
Password = $postgres_password
Host = cloudreve-postgres
Name = cloudreve

[Redis]
Server = cloudreve-redis:6379
EOF

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_POSTGRES_PASSWORD="$postgres_password"
export TEST_SESSION_SECRET="$session_secret"
export TEST_POSTGRES_EXISTS=1
export TEST_DEPLOYMENT_EXISTS=1
export TEST_SECRET_PRESENT=0
export TEST_LIVE_PASSWORD=""
export TEST_LIVE_CONF=""

for invalid_file in missing-session extra invalid-password duplicate; do
  : >"$TEST_KUBECTL_LOG"
  if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/$invalid_file.env" >"$test_root/$invalid_file-output" 2>&1; then
    echo "sync-cloudreve-secret accepted $invalid_file input" >&2
    exit 1
  fi
  [[ ! -s "$TEST_KUBECTL_LOG" ]]
done

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" --validate-only - \
  <"$test_root/cloudreve.env" >"$test_root/validate-output"
grep -q '^Cloudreve environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/initial-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/initial-output"
grep -q -- '--kubeconfig /etc/rancher/k3s/k3s.yaml config view' "$TEST_KUBECTL_LOG"
grep -q 'create namespace cloudreve --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q 'create secret generic cloudreve-env --namespace cloudreve --from-file=POSTGRES_PASSWORD=' "$TEST_KUBECTL_LOG"
grep -q 'rollout status statefulset/cloudreve-postgres --namespace cloudreve --timeout=180s' "$TEST_KUBECTL_LOG"
grep -q 'exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql' "$TEST_KUBECTL_LOG"
grep -q 'patch deployment/cloudreve --namespace cloudreve --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/cloudreve --namespace cloudreve --timeout=300s' "$TEST_KUBECTL_LOG"
if grep -q "$postgres_password\|$session_secret" "$test_root/initial-output"; then
  echo 'sync-cloudreve-secret printed secret input' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
export TEST_SECRET_PRESENT=1
TEST_LIVE_PASSWORD="$(base64 -w0 <"$test_root/POSTGRES_PASSWORD")"
TEST_LIVE_CONF="$(base64 -w0 <"$test_root/conf.ini")"
export TEST_LIVE_PASSWORD TEST_LIVE_CONF
bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/unchanged-output"
grep -q '^Cloudreve Secret synchronized to local K3s$' "$test_root/unchanged-output"
if grep -qE ' exec | patch deployment| rollout status ' "$TEST_KUBECTL_LOG"; then
  echo 'sync-cloudreve-secret restarted unchanged Cloudreve credentials' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/sync-cloudreve-secret" "$test_root/cloudreve.env" >"$test_root/remote-output" 2>&1; then
  echo 'sync-cloudreve-secret accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]

printf 'Cloudreve agenix Secret synchronization validates input, restores local k3s, and only restarts changed credentials\n'
