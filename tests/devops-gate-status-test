#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/systemctl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_SYSTEMCTL_LOG"
case "$*" in
  "is-active --quiet k3s.service"|"is-active --quiet woodpecker-secret-sync.service")
    exit 0
    ;;
esac
exit 1
EOF

cat >"$test_root/bin/curl" <<'EOF'
#!@bash@
url="${!#}"
printf '%s\n' "$url" >>"$TEST_CURL_LOG"
if [[ "$url" == *"woodpecker.localhost"* ]]; then
  printf '%s' "$TEST_WOODPECKER_STATUS"
else
  printf '200'
fi
EOF

cat >"$test_root/bin/sudo" <<'EOF'
#!@bash@
if [[ "$*" == "-n test -s /run/agenix/woodpecker-server-env" ]]; then
  exit 0
fi
exit 1
EOF

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "${TEST_KUBE_SERVER}"
elif [[ "$*" == *"woodpecker-server-env"* ]]; then
  printf 'secret/woodpecker-server-env\n'
elif [[ "$*" == *" get deployment/woodpecker "* ]]; then
  [[ "$TEST_NOT_READY" == "deployment/woodpecker" ]] && printf '0 1' || printf '1 1'
elif [[ "$*" == *" get statefulset/woodpecker-agent "* ]]; then
  [[ "$TEST_NOT_READY" == "statefulset/woodpecker-agent" ]] && printf '2 3' || printf '3 3'
elif [[ "$*" == *" get daemonset/dagger "* ]]; then
  [[ "$TEST_NOT_READY" == "daemonset/dagger" ]] && printf '0 1' || printf '1 1'
fi
EOF

sed -i "s|@bash@|$BASH|" "$test_root/bin/"*
chmod +x "$test_root/bin/"*
export PATH="$test_root/bin:$PATH"
export TEST_SYSTEMCTL_LOG="$test_root/systemctl.log"
export TEST_CURL_LOG="$test_root/curl.log"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_NOT_READY=""
export TEST_WOODPECKER_STATUS="204"

cd "$repo_root"
bash scripts/devops-gate-status >"$test_root/output"

grep -q '^ok: K3s service active$' "$test_root/output"
grep -q '^ok: Forgejo endpoint responds (K3s)$' "$test_root/output"
grep -q '^ok: Woodpecker Secret sync service active$' "$test_root/output"
grep -q '^ok: Woodpecker agenix runtime secret exists$' "$test_root/output"
grep -q '^ok: Woodpecker K3s secret exists$' "$test_root/output"
grep -q '^ok: Woodpecker server workload ready$' "$test_root/output"
grep -q '^ok: Woodpecker agent workload ready$' "$test_root/output"
grep -q '^ok: Dagger workload ready$' "$test_root/output"
grep -q '^ok: Woodpecker endpoint responds (K3s)$' "$test_root/output"
grep -q '^summary: 0 failed, 0 pending$' "$test_root/output"
[[ "$(cat "$TEST_SYSTEMCTL_LOG")" == $'is-active --quiet k3s.service\nis-active --quiet woodpecker-secret-sync.service' ]]
[[ "$(cat "$TEST_CURL_LOG")" == $'http://forgejo.localhost:17480/api/healthz\nhttp://woodpecker.localhost:17480/healthz' ]]
awk '$1 != "--kubeconfig" || $2 != "/etc/rancher/k3s/k3s.yaml" { exit 1 }' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 5 ]]

export TEST_NOT_READY="daemonset/dagger"
if bash scripts/devops-gate-status --strict >"$test_root/not-ready-output" 2>&1; then
  echo "devops-gate-status accepted an unready Dagger workload" >&2
  exit 1
fi
grep -q '^fail: Dagger workload ready$' "$test_root/not-ready-output"

export TEST_NOT_READY=""
export TEST_WOODPECKER_STATUS="503"
if bash scripts/devops-gate-status --strict >"$test_root/unhealthy-output" 2>&1; then
  echo "devops-gate-status accepted an unhealthy Woodpecker endpoint" >&2
  exit 1
fi
grep -q '^fail: Woodpecker endpoint responds (K3s)$' "$test_root/unhealthy-output"

if bash scripts/devops-gate-status --deep >"$test_root/deep-output" 2>&1; then
  echo "devops-gate-status accepted the removed remote-cluster deep gate" >&2
  exit 1
fi
grep -q '^usage: devops-gate-status \[--strict\]$' "$test_root/deep-output"

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://kube-new.flicknote.app"
export TEST_WOODPECKER_STATUS="204"
if bash scripts/devops-gate-status >"$test_root/remote-output" 2>&1; then
  echo "devops-gate-status accepted a non-local cluster" >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
