#!/usr/bin/env bash
set -euo pipefail
repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf -- "$test_root"' EXIT
mkdir -p "$test_root/bin" "$test_root/tmp"
cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"
if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace penpot "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" get secret penpot-credentials "* ]]; then
  [[ "$TEST_GET_FAIL" != 1 ]]
  if [[ "$TEST_SECRET_EXISTS" == 1 ]]; then printf 'secret/penpot-credentials'; fi
elif [[ "$*" == *" get pvc penpot-postgres-data "* ]]; then
  if [[ "$TEST_DATA_EXISTS" == 1 ]]; then printf 'pvc/penpot-postgres-data'; fi
elif [[ "$*" == *" create secret generic penpot-credentials "* ]]; then
  count=0
  for argument in "$@"; do
    case "$argument" in
      --from-file=*)
        source_file="${argument#--from-file=}"
        source_file="${source_file#*=}"
        [[ "$source_file" == "$TMPDIR/"* ]]
        [[ "$(stat -c %a "$source_file")" == 600 ]]
        [[ "$(stat -c %a "$(dirname "$source_file")")" == 700 ]]
        [[ "$(cat "$source_file")" == fixture-penpot-secret ]]
        [[ "$(wc -c <"$source_file")" -eq 21 ]]
        printf '%s\n' "$source_file" >>"$TEST_SECRET_PATHS"
        count=$((count + 1))
        ;;
    esac
  done
  [[ "$count" == 2 && "$TEST_FAIL_CREATE" != 1 ]]
  printf 'secret/penpot-credentials created\n'
elif [[ "$*" == *" apply -f -"* ]]; then
  cat >/dev/null
else
  printf 'unexpected kubectl call\n' >&2; exit 1
fi
EOF
cat >"$test_root/bin/openssl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_OPENSSL_LOG"
printf 'fixture-penpot-secret\n'
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl" "$test_root/bin/openssl"
chmod +x "$test_root/bin/"*
export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log" TEST_OPENSSL_LOG="$test_root/openssl.log"
export TEST_SECRET_PATHS="$test_root/secret-paths" TMPDIR="$test_root/tmp"
export KUBECONFIG="$test_root/kubeconfig" TEST_KUBE_SERVER='https://127.0.0.1:26443'
export TEST_SECRET_EXISTS=0 TEST_DATA_EXISTS=0 TEST_GET_FAIL=0 TEST_FAIL_CREATE=0
# First run creates two private, newline-free values and never exposes them.
bash "$repo_root/scripts/init-penpot-secrets" >"$test_root/output" 2>&1
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 2 ]]
if grep -q fixture-penpot-secret "$test_root/output"; then exit 1; fi
while IFS= read -r path; do [[ ! -e "$path" ]]; done <"$TEST_SECRET_PATHS"
# A repeated deploy keeps credentials and does not call the generator.
: >"$TEST_OPENSSL_LOG"; : >"$TEST_KUBECTL_LOG"
export TEST_SECRET_EXISTS=1
bash "$repo_root/scripts/init-penpot-secrets" >"$test_root/output" 2>&1
[[ ! -s "$TEST_OPENSSL_LOG" ]]
if grep -q 'create secret generic' "$TEST_KUBECTL_LOG"; then exit 1; fi
# Remote clusters, API errors, and lost credentials with retained data fail closed.
export TEST_SECRET_EXISTS=0
for failure in remote api data; do
  : >"$TEST_OPENSSL_LOG"; : >"$TEST_KUBECTL_LOG"
  export TEST_KUBE_SERVER='https://127.0.0.1:26443' TEST_GET_FAIL=0 TEST_DATA_EXISTS=0
  case "$failure" in
    remote) export TEST_KUBE_SERVER='https://remote.example.invalid' ;;
    api) export TEST_GET_FAIL=1 ;;
    data) export TEST_DATA_EXISTS=1 ;;
  esac
  if bash "$repo_root/scripts/init-penpot-secrets" >"$test_root/output" 2>&1; then exit 1; fi
  [[ ! -s "$TEST_OPENSSL_LOG" ]]
done
# Failed creation still removes both temporary files.
export TEST_KUBE_SERVER='https://127.0.0.1:26443' TEST_GET_FAIL=0 TEST_DATA_EXISTS=0 TEST_FAIL_CREATE=1
if bash "$repo_root/scripts/init-penpot-secrets" >"$test_root/output" 2>&1; then exit 1; fi
while IFS= read -r path; do [[ ! -e "$path" ]]; done <"$TEST_SECRET_PATHS"
printf 'Penpot credentials are local-only, private, idempotent, and fail closed\n'
