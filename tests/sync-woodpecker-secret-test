#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

cat >"$test_root/kubectl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
  if [[ "$manifest" == *"kind: Secret"* ]]; then
    printf 'secret/woodpecker-server-env configured\n'
  else
    printf 'namespace/devops unchanged\n'
  fi
elif [[ "$*" == *" get deployment/woodpecker "* || "$*" == *" get statefulset/woodpecker-agent "* ]]; then
  exit 0
elif [[ "$*" == *" rollout restart "* || "$*" == *" rollout status "* ]]; then
  exit 0
fi
EOF

sed -i "s|@bash@|$BASH|" "$test_root/kubectl"
chmod +x "$test_root/kubectl"
printf '%s\n' 'WOODPECKER_AGENT_SECRET=test' >"$test_root/woodpecker.env"
export PATH="$test_root:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"

bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/woodpecker.env"

awk '$1 != "--kubeconfig" || $2 != "/etc/rancher/k3s/k3s.yaml" { exit 1 }' "$TEST_KUBECTL_LOG"
grep -q 'create namespace devops --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q "create secret generic woodpecker-server-env --namespace devops --from-env-file=$test_root/woodpecker.env --dry-run=client -o yaml" "$TEST_KUBECTL_LOG"
grep -q 'rollout restart deployment/woodpecker --namespace devops' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/woodpecker --namespace devops --timeout=120s' "$TEST_KUBECTL_LOG"
grep -q 'rollout restart statefulset/woodpecker-agent --namespace devops' "$TEST_KUBECTL_LOG"
grep -q 'rollout status statefulset/woodpecker-agent --namespace devops --timeout=120s' "$TEST_KUBECTL_LOG"

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://kube-new.flicknote.app"
if bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/woodpecker.env" >"$test_root/remote-output" 2>&1; then
  echo "sync-woodpecker-secret accepted a non-local cluster" >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
