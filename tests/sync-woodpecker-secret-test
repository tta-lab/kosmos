#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

cat >"$test_root/kubectl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
  if [[ "$manifest" == *"kind: Secret"* ]]; then
    printf 'secret/woodpecker-server-env %s\n' "$TEST_SECRET_APPLY_RESULT"
  else
    printf 'namespace/devops unchanged\n'
  fi
elif [[ "$*" == *" get secret woodpecker-server-env "* && "$*" == *"jsonpath={.metadata.resourceVersion}"* ]]; then
  printf '42'
elif [[ "$*" == *" get secret woodpecker-postgres-env "* && "$*" == *"jsonpath={.metadata.resourceVersion}"* ]]; then
  printf '43'
elif [[ "$*" == *" get deployment/woodpecker "* || "$*" == *" get statefulset/woodpecker-agent "* || "$*" == *" get statefulset/woodpecker-postgres "* ]]; then
  exit 0
elif [[ "$*" == *" patch deployment/woodpecker "* || "$*" == *" patch statefulset/woodpecker-agent "* ]]; then
  exit 0
elif [[ "$*" == *" rollout status "* ]]; then
  exit 0
fi
EOF

sed -i "s|@bash@|$BASH|" "$test_root/kubectl"
chmod +x "$test_root/kubectl"
printf '%s\n' \
  'WOODPECKER_AGENT_SECRET=test-agent' \
  'WOODPECKER_FORGEJO_CLIENT=test-client' \
  'WOODPECKER_FORGEJO_SECRET=test-secret' \
  >"$test_root/woodpecker.env"
printf '%s\n' \
  'POSTGRES_PASSWORD=test-password' \
  'WOODPECKER_DATABASE_DATASOURCE=postgres://woodpecker:test-password@woodpecker-postgres:5432/woodpecker?sslmode=disable' \
  >"$test_root/postgres.env"
printf '%s\n' \
  'WOODPECKER_AGENT_SECRET=test-agent' \
  'WOODPECKER_FORGEJO_CLIENT=test-client' \
  >"$test_root/missing.env"
export PATH="$test_root:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_SECRET_APPLY_RESULT="configured"

: >"$TEST_KUBECTL_LOG"
if bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/missing.env" "$test_root/postgres.env" >"$test_root/missing-output" 2>&1; then
  echo "sync-woodpecker-secret accepted an incomplete environment file" >&2
  exit 1
fi
grep -q 'WOODPECKER_FORGEJO_SECRET' "$test_root/missing-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-woodpecker-secret" --validate-only - "$test_root/postgres.env" \
  <"$test_root/woodpecker.env" \
  >"$test_root/validate-output"
grep -q '^Woodpecker environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/woodpecker.env" "$test_root/postgres.env"

awk '$1 != "--kubeconfig" || $2 != "/etc/rancher/k3s/k3s.yaml" { exit 1 }' "$TEST_KUBECTL_LOG"
grep -q 'create namespace devops --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q "create secret generic woodpecker-server-env --namespace devops --from-env-file=$test_root/woodpecker.env --dry-run=client -o yaml" "$TEST_KUBECTL_LOG"
grep -q "create secret generic woodpecker-postgres-env --namespace devops --from-env-file=$test_root/postgres.env --dry-run=client -o yaml" "$TEST_KUBECTL_LOG"
grep -q 'get secret woodpecker-server-env --namespace devops -o jsonpath={.metadata.resourceVersion}' "$TEST_KUBECTL_LOG"
grep -q 'get secret woodpecker-postgres-env --namespace devops -o jsonpath={.metadata.resourceVersion}' "$TEST_KUBECTL_LOG"
grep -q 'patch deployment/woodpecker --namespace devops --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/woodpecker --namespace devops --timeout=120s' "$TEST_KUBECTL_LOG"
grep -q 'patch statefulset/woodpecker-agent --namespace devops --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status statefulset/woodpecker-agent --namespace devops --timeout=120s' "$TEST_KUBECTL_LOG"
grep -q 'patch statefulset/woodpecker-postgres --namespace devops --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status statefulset/woodpecker-postgres --namespace devops --timeout=120s' "$TEST_KUBECTL_LOG"

: >"$TEST_KUBECTL_LOG"
export TEST_SECRET_APPLY_RESULT="unchanged"
bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/woodpecker.env" "$test_root/postgres.env"

deployment_patch_line="$(grep -n 'patch deployment/woodpecker ' "$TEST_KUBECTL_LOG" | cut -d: -f1)"
agent_patch_line="$(grep -n 'patch statefulset/woodpecker-agent ' "$TEST_KUBECTL_LOG" | cut -d: -f1)"
deployment_status_line="$(grep -n 'rollout status deployment/woodpecker ' "$TEST_KUBECTL_LOG" | cut -d: -f1)"
agent_status_line="$(grep -n 'rollout status statefulset/woodpecker-agent ' "$TEST_KUBECTL_LOG" | cut -d: -f1)"
[[ "$deployment_patch_line" -lt "$deployment_status_line" ]]
[[ "$agent_patch_line" -lt "$deployment_status_line" ]]
[[ "$deployment_patch_line" -lt "$agent_status_line" ]]
[[ "$agent_patch_line" -lt "$agent_status_line" ]]

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://kube-new.flicknote.app"
if bash "$repo_root/scripts/sync-woodpecker-secret" "$test_root/woodpecker.env" "$test_root/postgres.env" >"$test_root/remote-output" 2>&1; then
  echo "sync-woodpecker-secret accepted a non-local cluster" >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
