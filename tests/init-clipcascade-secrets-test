#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT
fake_bin="$test_root/bin"
mkdir -p "$fake_bin" "$test_root/secrets"

cat >"$fake_bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"
if [[ "$*" == *' config view '* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *' get secret '* ]]; then
  [[ "${TEST_SECRET_EXISTS:-no}" == yes ]]
elif [[ "$*" == *' apply -f -'* ]]; then
  cat >/dev/null
  [[ "${TEST_APPLY_FAIL:-no}" != yes ]]
else
  # create namespace/secret --dry-run output is consumed by the apply call.
  printf 'apiVersion: v1\nkind: Secret\n'
fi
EOF
sed -i "s|@bash@|$BASH|" "$fake_bin/kubectl"
chmod +x "$fake_bin/kubectl"

cat >"$fake_bin/openssl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_OPENSSL_LOG"
printf 'fixture-secret-value\n'
EOF
sed -i "s|@bash@|$BASH|" "$fake_bin/openssl"
chmod +x "$fake_bin/openssl"

export PATH="$fake_bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_OPENSSL_LOG="$test_root/openssl.log"
export TEST_KUBE_SERVER='https://127.0.0.1:26443'
export CLIPCASCADE_SECRET_TMPDIR="$test_root/secrets"

bash "$repo_root/scripts/init-clipcascade-secrets" >"$test_root/first-output"
grep -q '^Created ClipCascade database credentials$' "$test_root/first-output"
grep -q 'create secret generic clipcascade-database' "$TEST_KUBECTL_LOG"
grep -q -- '--from-file=CC_SERVER_DB_PASSWORD=' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 2 ]]
if grep -q 'fixture-secret-value' "$test_root/first-output"; then
  echo 'initializer printed generated secret material' >&2
  exit 1
fi
[[ -z "$(find "$test_root/secrets" -mindepth 1 -maxdepth 1 -print -quit)" ]]

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_SECRET_EXISTS=yes
bash "$repo_root/scripts/init-clipcascade-secrets" >"$test_root/existing-output"
grep -q '^Kept existing ClipCascade database credentials$' "$test_root/existing-output"
if grep -q 'create secret generic' "$TEST_KUBECTL_LOG"; then
  echo 'initializer replaced an existing Secret' >&2
  exit 1
fi
[[ ! -s "$TEST_OPENSSL_LOG" ]]

export TEST_KUBE_SERVER='https://kube-new.flicknote.app'
if bash "$repo_root/scripts/init-clipcascade-secrets" >"$test_root/remote-output" 2>&1; then
  echo 'ClipCascade Secret initializer accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"

export TEST_KUBE_SERVER='https://127.0.0.1:26443'
export TEST_SECRET_EXISTS=no
export TEST_APPLY_FAIL=yes
if bash "$repo_root/scripts/init-clipcascade-secrets" >"$test_root/failure-output" 2>&1; then
  echo 'ClipCascade Secret initializer ignored a Kubernetes apply failure' >&2
  exit 1
fi
[[ -z "$(find "$test_root/secrets" -mindepth 1 -maxdepth 1 -print -quit)" ]]

printf 'ClipCascade database Secret initialization is local-only, idempotent, private, and cleanup-safe\n'
