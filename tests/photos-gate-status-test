#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/systemctl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_SYSTEMCTL_LOG"
[[ "$*" == "is-active --quiet ente-secret-sync.service" && "$TEST_SYNC_ACTIVE" == "yes" ]]
EOF

cat >"$test_root/bin/curl" <<'EOF'
#!@bash@
url="${!#}"
args="$*"
header_file=""
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--dump-header" ]]; then
    header_file="$2"
    shift 2
  else
    shift
  fi
done
printf '%s\n' "$url" >>"$TEST_CURL_LOG"
if [[ "$url" == "http://ente-storage.localhost:17480/b2-eu-cen/cors-probe" ]]; then
  if [[ "$args" == *"--request OPTIONS"* \
    && "$args" == *"Origin: http://localhost"* \
    && "$args" == *"Access-Control-Request-Method: GET"* ]]; then
    if [[ -n "$header_file" ]]; then
      printf 'HTTP/1.1 %s Test\r\nAccess-Control-Allow-Origin: %s\r\nAccess-Control-Allow-Methods: %s\r\n\r\n' \
        "$TEST_CORS_HTTP_STATUS" \
        "$TEST_CORS_ALLOW_ORIGIN" \
        "$TEST_CORS_ALLOW_METHODS" >"$header_file"
    fi
    printf '%s' "$TEST_CORS_HTTP_STATUS"
  else
    printf '400'
  fi
elif [[ "$url" == "http://ente-storage.localhost:17480/" ]]; then
  printf '%s' "$TEST_STORAGE_HTTP_STATUS"
else
  printf '%s' "$TEST_MUSEUM_HTTP_STATUS"
fi
EOF

cat >"$test_root/bin/df" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_DF_LOG"
printf '%s\n' \
  'Filesystem      Size  Used Avail Use% Mounted on' \
  '/dev/sdd        1.0T  402G  554G  43% /'
EOF

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" get deployment/museum "* ]]; then
  [[ "$TEST_NOT_READY" == "deployment/museum" ]] && printf '0 1' || printf '1 1'
elif [[ "$*" == *" get statefulset/postgres "* ]]; then
  [[ "$TEST_NOT_READY" == "statefulset/postgres" ]] && printf '0 1' || printf '1 1'
elif [[ "$*" == *" get statefulset/garage "* ]]; then
  [[ "$TEST_NOT_READY" == "statefulset/garage" ]] && printf '0 1' || printf '1 1'
elif [[ "$*" == *" exec -n photos garage-0 -- /garage bucket info b2-eu-cen"* ]]; then
  [[ "$TEST_BUCKET_PRESENT" == "yes" ]]
fi
EOF

sed -i "s|@bash@|$BASH|" "$test_root/bin/"*
chmod +x "$test_root/bin/"*

export PATH="$test_root/bin:$PATH"
export TEST_SYSTEMCTL_LOG="$test_root/systemctl.log"
export TEST_CURL_LOG="$test_root/curl.log"
export TEST_DF_LOG="$test_root/df.log"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_SYNC_ACTIVE="yes"
export TEST_MUSEUM_HTTP_STATUS="200"
export TEST_STORAGE_HTTP_STATUS="403"
export TEST_CORS_HTTP_STATUS="200"
export TEST_CORS_ALLOW_ORIGIN="*"
export TEST_CORS_ALLOW_METHODS="GET, PUT, POST, DELETE"
export TEST_BUCKET_PRESENT="yes"
export TEST_NOT_READY=""

cd "$repo_root"
bash scripts/photos-gate-status --strict >"$test_root/output"

grep -q '^ok: Ente Secret sync service active$' "$test_root/output"
grep -q '^ok: Museum workload ready$' "$test_root/output"
grep -q '^ok: PostgreSQL workload ready$' "$test_root/output"
grep -q '^ok: Garage workload ready$' "$test_root/output"
grep -q '^ok: Museum endpoint responds through canonical gateway$' "$test_root/output"
grep -q '^ok: Garage S3 endpoint responds through canonical gateway$' "$test_root/output"
grep -q '^ok: Garage S3 endpoint accepts browser CORS preflight$' "$test_root/output"
grep -q '^ok: Garage bucket b2-eu-cen exists$' "$test_root/output"
grep -q '^Garage storage filesystem:$' "$test_root/output"
grep -q '^summary: 0 failed$' "$test_root/output"
[[ "$(cat "$TEST_SYSTEMCTL_LOG")" == 'is-active --quiet ente-secret-sync.service' ]]
[[ "$(cat "$TEST_CURL_LOG")" == $'http://ente.localhost:17480/ping\nhttp://ente-storage.localhost:17480/\nhttp://ente-storage.localhost:17480/b2-eu-cen/cors-probe' ]]
[[ "$(cat "$TEST_DF_LOG")" == '-h /var/lib/kosmos-k3s' ]]
awk '$1 != "--kubeconfig" || $2 != "/etc/rancher/k3s/k3s.yaml" { exit 1 }' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 5 ]]

export TEST_NOT_READY="statefulset/garage"
if bash scripts/photos-gate-status --strict >"$test_root/not-ready-output" 2>&1; then
  echo "photos-gate-status accepted an unready Garage workload" >&2
  exit 1
fi
grep -q '^fail: Garage workload ready$' "$test_root/not-ready-output"

export TEST_NOT_READY=""
export TEST_MUSEUM_HTTP_STATUS="503"
if bash scripts/photos-gate-status --strict >"$test_root/unhealthy-output" 2>&1; then
  echo "photos-gate-status accepted an unhealthy Museum endpoint" >&2
  exit 1
fi
grep -q '^fail: Museum endpoint responds through canonical gateway$' "$test_root/unhealthy-output"

export TEST_MUSEUM_HTTP_STATUS="200"

export TEST_STORAGE_HTTP_STATUS="502"
if bash scripts/photos-gate-status --strict >"$test_root/storage-output" 2>&1; then
  echo "photos-gate-status accepted an unhealthy Garage S3 endpoint" >&2
  exit 1
fi
grep -q '^fail: Garage S3 endpoint responds through canonical gateway$' "$test_root/storage-output"

export TEST_STORAGE_HTTP_STATUS="403"

export TEST_CORS_HTTP_STATUS="403"
if bash scripts/photos-gate-status --strict >"$test_root/cors-output" 2>&1; then
  echo "photos-gate-status accepted a rejected Garage CORS preflight" >&2
  exit 1
fi
grep -q '^fail: Garage S3 endpoint accepts browser CORS preflight$' "$test_root/cors-output"

export TEST_CORS_HTTP_STATUS="200"
export TEST_CORS_ALLOW_ORIGIN=""
if bash scripts/photos-gate-status --strict >"$test_root/cors-origin-output" 2>&1; then
  echo "photos-gate-status accepted a CORS preflight without an allowed origin" >&2
  exit 1
fi
grep -q '^fail: Garage S3 endpoint accepts browser CORS preflight$' "$test_root/cors-origin-output"

export TEST_CORS_ALLOW_ORIGIN="*"
export TEST_CORS_ALLOW_METHODS="PUT, POST, DELETE"
if bash scripts/photos-gate-status --strict >"$test_root/cors-method-output" 2>&1; then
  echo "photos-gate-status accepted a CORS preflight that does not allow GET" >&2
  exit 1
fi
grep -q '^fail: Garage S3 endpoint accepts browser CORS preflight$' "$test_root/cors-method-output"

export TEST_CORS_ALLOW_METHODS="GET, PUT, POST, DELETE"
export TEST_BUCKET_PRESENT="no"
if bash scripts/photos-gate-status --strict >"$test_root/bucket-output" 2>&1; then
  echo "photos-gate-status accepted a missing Garage bucket" >&2
  exit 1
fi
grep -q '^fail: Garage bucket b2-eu-cen exists$' "$test_root/bucket-output"

export TEST_BUCKET_PRESENT="yes"
export TEST_SYNC_ACTIVE="no"
if bash scripts/photos-gate-status --strict >"$test_root/sync-output" 2>&1; then
  echo "photos-gate-status accepted an inactive Secret sync unit" >&2
  exit 1
fi
grep -q '^fail: Ente Secret sync service active$' "$test_root/sync-output"

: >"$TEST_KUBECTL_LOG"
export TEST_SYNC_ACTIVE="yes"
export TEST_KUBE_SERVER="https://kube-new.flicknote.app"
if bash scripts/photos-gate-status >"$test_root/remote-output" 2>&1; then
  echo "photos-gate-status accepted a non-local cluster" >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
