#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$repo_root/scripts/ttal-tmux-project-picker"

projects_json='[
  {"alias":"ko","name":"kosmos","path":"/home/neil/code/projects/tta-lab/kosmos"},
  {"alias":"fb.ai","name":"Ai Workflow Processor","path":"/home/neil/code/projects/GuionAI/flick-backend/services/ai-processor"}
]'

output="$(
  TTAL_TMUX_PROJECTS_JSON="$projects_json" \
  TTAL_TMUX_SESSION_ID=1234abcd \
  "$script" --dry-run --alias fb.ai
)"

expected='tmux new-session -ds fb-ai-1234abcd -c /home/neil/code/projects/GuionAI/flick-backend/services/ai-processor
tmux switch-client -t fb-ai-1234abcd'

if [[ "$output" != "$expected" ]]; then
  printf 'unexpected dry-run output\nexpected:\n%s\nactual:\n%s\n' "$expected" "$output" >&2
  exit 1
fi

if TTAL_TMUX_PROJECTS_JSON="$projects_json" "$script" --dry-run --alias missing >/tmp/ttal-picker-test.out 2>/tmp/ttal-picker-test.err; then
  printf 'missing alias should fail\n' >&2
  exit 1
fi

if ! grep -q 'unknown project alias: missing' /tmp/ttal-picker-test.err; then
  printf 'missing alias error was not clear\n' >&2
  cat /tmp/ttal-picker-test.err >&2
  exit 1
fi
