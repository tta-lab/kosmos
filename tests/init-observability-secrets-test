#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT
mkdir -p "$test_root/bin" "$test_root/tmp"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace observability "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" get secret grafana-admin "* ]]; then
  [[ "$TEST_SECRET_EXISTS" == 1 ]]
elif [[ "$*" == *" create secret generic grafana-admin "* ]]; then
  source_file=""
  for argument in "$@"; do
    case "$argument" in
      --from-file=admin-password=*) source_file="${argument#--from-file=admin-password=}" ;;
    esac
  done
  [[ -n "$source_file" && -r "$source_file" ]]
  [[ "$(stat -c %a "$source_file")" == 600 ]]
  [[ "$(wc -c <"$source_file")" -ge 32 ]]
  printf '%s\n' "$source_file" >"$TEST_SECRET_FILE"
  [[ "$TEST_FAIL_CREATE" != 1 ]]
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *'apiVersion: v1'* ]]
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

cat >"$test_root/bin/openssl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_OPENSSL_LOG"
printf '%s' fixture-secret-value-for-observability-test
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/openssl"
chmod +x "$test_root/bin/openssl"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_OPENSSL_LOG="$test_root/openssl.log"
export TEST_SECRET_FILE="$test_root/secret-path"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_SECRET_EXISTS=0
export TEST_FAIL_CREATE=0
export KUBECONFIG="$test_root/kubeconfig"
export OBSERVABILITY_SECRET_TMPDIR="$test_root/tmp"

bash "$repo_root/scripts/init-observability-secrets" >"$test_root/first-output"
grep -q '^Created Grafana admin credentials$' "$test_root/first-output"
grep -q -- "create secret generic grafana-admin --namespace observability --from-file=admin-password=" "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 1 ]]
secret_path="$(cat "$TEST_SECRET_FILE")"
[[ ! -e "$secret_path" ]]
if grep -q 'fixture-secret-value-for-observability-test' "$test_root/first-output"; then
  echo 'init-observability-secrets printed generated credentials' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_SECRET_EXISTS=1
bash "$repo_root/scripts/init-observability-secrets" >"$test_root/existing-output"
grep -q '^Kept existing Grafana admin credentials$' "$test_root/existing-output"
[[ ! -s "$TEST_OPENSSL_LOG" ]]
if grep -q 'create secret generic' "$TEST_KUBECTL_LOG"; then
  echo 'init-observability-secrets replaced an existing Secret' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
export TEST_SECRET_EXISTS=0
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/init-observability-secrets" >"$test_root/remote-output" 2>&1; then
  echo 'init-observability-secrets accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
[[ ! -s "$TEST_OPENSSL_LOG" ]]

export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_FAIL_CREATE=1
if bash "$repo_root/scripts/init-observability-secrets" >"$test_root/failure-output" 2>&1; then
  echo 'init-observability-secrets ignored Secret creation failure' >&2
  exit 1
fi
secret_path="$(cat "$TEST_SECRET_FILE")"
[[ ! -e "$secret_path" ]]

printf 'Grafana Secret initialization is local-only, idempotent, private, and cleanup-safe\n'
