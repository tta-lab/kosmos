#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:?KOSMOS_REPO_ROOT is required}"
rendered="$(mktemp)"
trap 'rm -f -- "$rendered"' EXIT

jsonnet -S "$repo_root/kepos/peer-policy.jsonnet" >"$rendered"
python3 - "$rendered" <<'PY'
import sys
import tomllib

with open(sys.argv[1], "rb") as policy_file:
    services = {service["id"]: service for service in tomllib.load(policy_file)["services"]}

mac = "c5a2168e17a53b699ced7e3f3c8470afd7f91b97a1582076c9797c3e024311a2"
pixel = "d1c8e7bad4f0468a12d54c5b80d175677ff58c833f9e666f8a838b0d6b9256bc"
for service_id, port in (("dev-lamplit", 3082), ("prod-lamplit", 3084)):
    service = services[service_id]
    assert service["source"]["local_port"] == port
    assert service["allow"] == [mac, pixel]
assert "dsh" in services
PY
