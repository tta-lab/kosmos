#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" get secret cloudreve-env "* ]]; then
  [[ "$TEST_EXISTING_SECRETS" == *cloudreve* ]]
elif [[ "$*" == *" create namespace cloudreve "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic "* ]]; then
  [[ "$*" != *"--from-literal"* ]]
  [[ "$*" == *"--from-file=POSTGRES_PASSWORD="* ]]
  [[ "$*" == *"--from-file=conf.ini="* ]]
  password_file=""
  config_file=""
  for argument in "$@"; do
    case "$argument" in
      --from-file=POSTGRES_PASSWORD=*) password_file="${argument#--from-file=POSTGRES_PASSWORD=}" ;;
      --from-file=conf.ini=*) config_file="${argument#--from-file=conf.ini=}" ;;
    esac
  done
  [[ -n "$password_file" && -n "$config_file" ]]
  grep -qx 'generated-secret-value' "$password_file"
  grep -q '^\[System\]$' "$config_file"
  grep -q '^ProxyHeader = X-Forwarded-For$' "$config_file"
  grep -q '^\[Database\]$' "$config_file"
  grep -q '^\[Redis\]$' "$config_file"
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql "* ]]; then
  statement="$(cat)"
  [[ "$statement" == "ALTER USER cloudreve PASSWORD 'generated-secret-value';" ]]
elif [[ "$*" == *" apply -f "* ]]; then
  manifest_path="${!#}"
  if [[ "$manifest_path" == "-" ]]; then
    manifest="$(cat)"
  else
    manifest="$(<"$manifest_path")"
  fi
  [[ "$manifest" == *"apiVersion: v1"* ]]
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

cat >"$test_root/bin/openssl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_OPENSSL_LOG"
printf 'generated-secret-value'
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/openssl"
chmod +x "$test_root/bin/openssl"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_OPENSSL_LOG="$test_root/openssl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_EXISTING_SECRETS=""
export KUBECONFIG="$test_root/local-kubeconfig"

bash "$repo_root/scripts/init-cloudreve-secrets" >"$test_root/first-output"
grep -q '^Created Cloudreve credentials and configuration$' "$test_root/first-output"
grep -q -- "--kubeconfig $KUBECONFIG config view" "$TEST_KUBECTL_LOG"
grep -q 'create secret generic cloudreve-env --namespace cloudreve --from-file=POSTGRES_PASSWORD=' "$TEST_KUBECTL_LOG"
grep -q -- '--from-file=conf.ini=' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 2 ]]
if grep -q 'generated-secret-value' "$test_root/first-output"; then
  echo 'init-cloudreve-secrets printed a generated value' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_EXISTING_SECRETS="cloudreve"
bash "$repo_root/scripts/init-cloudreve-secrets" >"$test_root/existing-output"
grep -q '^Kept existing Cloudreve credentials and configuration$' "$test_root/existing-output"
[[ ! -s "$TEST_OPENSSL_LOG" ]]
if grep -qE 'create secret generic| exec ' "$TEST_KUBECTL_LOG"; then
  echo 'init-cloudreve-secrets changed an existing Secret' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
bash "$repo_root/scripts/init-cloudreve-secrets" --rotate >"$test_root/rotation-output"
grep -q '^Rotated Cloudreve credentials and configuration$' "$test_root/rotation-output"
grep -q 'exec --namespace cloudreve cloudreve-postgres-0 --container postgres --stdin -- psql' "$TEST_KUBECTL_LOG"
grep -q 'create secret generic cloudreve-env --namespace cloudreve --from-file=POSTGRES_PASSWORD=' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 2 ]]
if grep -q 'generated-secret-value' "$test_root/rotation-output"; then
  echo 'init-cloudreve-secrets printed a rotated value' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_EXISTING_SECRETS=""
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/init-cloudreve-secrets" >"$test_root/remote-output" 2>&1; then
  echo 'init-cloudreve-secrets accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ ! -s "$TEST_OPENSSL_LOG" ]]

printf 'Cloudreve Secret initialization and rotation are local-only, idempotent, and do not expose generated values\n'
