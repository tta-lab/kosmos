#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
rendered="$(mktemp)"
trap 'rm -f "$rendered"' EXIT

tk show --dangerous-allow-redirect "$repo_root/tanka/environments/ebooks" \
  | yq -s '.' >"$rendered"

jq -e '
  . as $resources |
  def resource($kind; $name):
    $resources | map(select(.kind == $kind and .metadata.name == $name)) | first;

  (resource("Namespace"; "ebooks").metadata.name == "ebooks") and
  (["booklore", "bookorbit"] | map(. as $name |
    (resource("Deployment"; $name).spec.template.spec.containers[0].readinessProbe.httpGet.path | length) > 0 and
    resource("Service"; $name).spec.type == "ClusterIP"
  ) | all) and
  (["booklore-mariadb", "bookorbit-postgres"] | map(. as $name |
    resource("StatefulSet"; $name).spec.replicas == 1
  ) | all) and
  (["kosmos-booklore", "kosmos-booklore-db", "kosmos-bookorbit", "kosmos-bookorbit-db"] | map(. as $name |
    resource("PersistentVolume"; $name).spec.persistentVolumeReclaimPolicy == "Retain"
  ) | all) and
  (["booklore-data", "booklore-db", "bookorbit-data", "bookorbit-db"] | map(. as $name |
    resource("PersistentVolumeClaim"; $name).spec.storageClassName == "kosmos-static"
  ) | all) and
  (map(select(.kind == "Secret")) | length == 0) and
  (resource("Deployment"; "booklore").spec.template.spec.containers[0].env |
    any(.name == "BOOKLORE_PORT" and .value == "6060")) and
  ([
    resource("Deployment"; "booklore").spec.template.spec.containers[0].env[],
    resource("StatefulSet"; "booklore-mariadb").spec.template.spec.containers[0].env[],
    resource("Deployment"; "bookorbit").spec.template.spec.containers[0].env[],
    resource("StatefulSet"; "bookorbit-postgres").spec.template.spec.containers[0].env[]
  ] | map(select(.valueFrom.secretKeyRef != null)) | length >= 6)
' "$rendered" >/dev/null

printf 'ebook manifests expose two healthy apps with retained storage and external Secret references\n'
