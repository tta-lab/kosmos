#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace anki "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic anki-sync-env "* ]]; then
  [[ "$*" == *"--from-env-file="* ]]
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
elif [[ "$*" == *" get secret anki-sync-env "* ]]; then
  printf '91'
elif [[ "$*" == *" get deployment/anki-sync-server "* ]]; then
  exit 0
elif [[ "$*" == *" patch deployment/anki-sync-server "* ]]; then
  exit 0
elif [[ "$*" == *" rollout status deployment/anki-sync-server "* ]]; then
  exit "${TEST_ROLLOUT_EXIT:-0}"
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

printf '%s\n' 'SYNC_USER1=ooneil:test-password' >"$test_root/anki.env"
printf '%s\n' 'SYNC_USER1=someone-else:test-password' >"$test_root/wrong-user.env"
printf '%s\n' 'SYNC_USER1=ooneil:' >"$test_root/empty-password.env"
printf '%s\n' 'SYNC_USER1=ooneil:test-password' 'EXTRA=value' >"$test_root/extra.env"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"

for invalid_file in wrong-user empty-password extra; do
  : >"$TEST_KUBECTL_LOG"
  if bash "$repo_root/scripts/sync-anki-secret" "$test_root/$invalid_file.env" >"$test_root/$invalid_file-output" 2>&1; then
    echo "sync-anki-secret accepted $invalid_file input" >&2
    exit 1
  fi
  [[ ! -s "$TEST_KUBECTL_LOG" ]]
done

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-anki-secret" --validate-only - \
  <"$test_root/anki.env" >"$test_root/validate-output"
grep -q '^Anki environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

bash "$repo_root/scripts/sync-anki-secret" "$test_root/anki.env" >"$test_root/sync-output"
grep -q '^Anki Secret synchronized to local K3s$' "$test_root/sync-output"
grep -q -- '--kubeconfig /etc/rancher/k3s/k3s.yaml config view' "$TEST_KUBECTL_LOG"
grep -q 'create namespace anki --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q "create secret generic anki-sync-env --namespace anki --from-env-file=$test_root/anki.env" "$TEST_KUBECTL_LOG"
grep -q 'patch deployment/anki-sync-server --namespace anki --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/anki-sync-server --namespace anki --timeout=180s' "$TEST_KUBECTL_LOG"

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/sync-anki-secret" "$test_root/anki.env" >"$test_root/remote-output" 2>&1; then
  echo 'sync-anki-secret accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]

printf 'Anki Secret synchronization validates ooneil and is restricted to local k3s\n'
