#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
module="$repo_root/modules/wsl/seafarer-edge.nix"

grep -q 'default = 8081;' "$module"
grep -q 'virtualHosts."http://:${toString cfg.proxyPort}"' "$module"
grep -q 'bind 127.0.0.1' "$module"
grep -q 'classifierPort = lib.mkOption' "$module"
grep -q 'default = 18083;' "$module"
grep -q '@classifier {' "$module"
grep -q 'host ${cfg.seafileHostname}' "$module"
grep -q 'path /upload /upload/\*' "$module"
grep -q 'reverse_proxy 127.0.0.1:${toString cfg.classifierPort}' "$module"
grep -q 'header_up X-Forwarded-Proto https' "$module"
grep -q 'respond "" 404' "$module"
grep -q 'services.cloudflared.tunnels.kepos.ingress' "$module"
grep -q 'http://127.0.0.1:${toString cfg.proxyPort}' "$module"
