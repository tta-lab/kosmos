#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace hindsight "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic hindsight-env "* ]]; then
  [[ "$*" == *"--from-env-file="* ]]
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
elif [[ "$*" == *" get secret hindsight-env "* ]]; then
  printf '108'
elif [[ "$*" == *" get deployment/hindsight "* ]]; then
  exit 0
elif [[ "$*" == *" patch deployment/hindsight "* ]]; then
  exit 0
elif [[ "$*" == *" rollout status deployment/hindsight "* ]]; then
  exit "${TEST_ROLLOUT_EXIT:-0}"
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

printf '%s\n' '# Hindsight credentials' '' 'HINDSIGHT_API_LLM_API_KEY=test-key' '' >"$test_root/hindsight.env"
printf '%s\n' 'HINDSIGHT_API_LLM_API_KEY=' >"$test_root/empty.env"
printf '%s\n' 'HINDSIGHT_API_LLM_API_KEY=test-key' 'EXTRA=value' >"$test_root/extra.env"
printf '%s\n' 'HINDSIGHT_API_LLM_API_KEY=test-key' 'HINDSIGHT_API_LLM_API_KEY=duplicate' >"$test_root/duplicate.env"
printf '%s\n' 'sk-review-sentinel' >"$test_root/raw.env"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"

for invalid_file in empty extra duplicate; do
  : >"$TEST_KUBECTL_LOG"
  if bash "$repo_root/scripts/sync-hindsight-secret" "$test_root/$invalid_file.env" >"$test_root/$invalid_file-output" 2>&1; then
    echo "sync-hindsight-secret accepted $invalid_file input" >&2
    exit 1
  fi
  [[ ! -s "$TEST_KUBECTL_LOG" ]]
done

: >"$TEST_KUBECTL_LOG"
if bash "$repo_root/scripts/sync-hindsight-secret" --validate-only "$test_root/raw.env" >"$test_root/raw-output" 2>&1; then
  echo 'sync-hindsight-secret accepted a raw credential' >&2
  exit 1
fi
if grep -q 'sk-review-sentinel' "$test_root/raw-output"; then
  echo 'sync-hindsight-secret exposed malformed secret input' >&2
  exit 1
fi
[[ ! -s "$TEST_KUBECTL_LOG" ]]

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-hindsight-secret" --validate-only - \
  <"$test_root/hindsight.env" >"$test_root/validate-output"
grep -q '^Hindsight environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

bash "$repo_root/scripts/sync-hindsight-secret" "$test_root/hindsight.env" >"$test_root/sync-output"
grep -q '^Hindsight Secret synchronized to local K3s$' "$test_root/sync-output"
grep -q -- '--kubeconfig /etc/rancher/k3s/k3s.yaml config view' "$TEST_KUBECTL_LOG"
grep -q 'create namespace hindsight --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q "create secret generic hindsight-env --namespace hindsight --from-env-file=$test_root/hindsight.env" "$TEST_KUBECTL_LOG"
grep -q 'patch deployment/hindsight --namespace hindsight --type=merge' "$TEST_KUBECTL_LOG"
grep -q 'rollout status deployment/hindsight --namespace hindsight --timeout=600s' "$TEST_KUBECTL_LOG"

: >"$TEST_KUBECTL_LOG"
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/sync-hindsight-secret" "$test_root/hindsight.env" >"$test_root/remote-output" 2>&1; then
  echo 'sync-hindsight-secret accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]

printf 'Hindsight Secret synchronization validates the LLM key without exposing input and is restricted to local k3s\n'
