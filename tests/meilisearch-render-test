#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
rendered="$(mktemp)"
trap 'rm -f "$rendered"' EXIT

tk show --dangerous-allow-redirect "$repo_root/tanka/environments/meilisearch" \
  | yq -s '.' >"$rendered"

jq -e '
  . as $resources |
  def resource($kind; $name):
    $resources | map(select(.kind == $kind and .metadata.name == $name)) | first;

  (resource("Namespace"; "meilisearch").metadata.name == "meilisearch") and
  (resource("Deployment"; "meilisearch").spec.replicas == 1) and
  (resource("Deployment"; "meilisearch").spec.strategy.type == "Recreate") and
  (resource("Deployment"; "meilisearch").spec.template.spec.containers[0] as $container |
    ($container.image == "getmeili/meilisearch:v1.53.2@sha256:c94e58ca09662dd6e65e8f1b0fd145767be3da7d5422a863a27b8d2b68e090c9") and
    ($container.securityContext.runAsNonRoot == true) and
    ($container.securityContext.readOnlyRootFilesystem == true) and
    ($container.env | any(.name == "MEILI_ENV" and .value == "production")) and
    ($container.env | any(.name == "MEILI_NO_ANALYTICS" and .value == "true")) and
    ($container.env | any(.name == "MEILI_MASTER_KEY" and .valueFrom.secretKeyRef.name == "meilisearch-master-key")) and
    ($container.volumeMounts | any(.name == "data" and .mountPath == "/meili_data")) and
    ($container.readinessProbe.httpGet.path == "/health")
  ) and
  (resource("Service"; "meilisearch").spec.type == "ClusterIP") and
  (resource("Service"; "meilisearch").spec.ports[0].port == 7700) and
  (resource("PersistentVolume"; "kosmos-meilisearch-data").spec.persistentVolumeReclaimPolicy == "Retain") and
  (resource("PersistentVolume"; "kosmos-meilisearch-data").spec.hostPath.path == "/var/lib/kosmos-k3s/meilisearch/data") and
  (resource("PersistentVolumeClaim"; "meilisearch-data").spec.storageClassName == "kosmos-static") and
  (map(select(.kind == "Secret")) | length == 0)
' "$rendered" >/dev/null

printf 'Meilisearch manifests expose a hardened service with retained storage\n'
