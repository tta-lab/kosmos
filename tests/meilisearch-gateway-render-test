#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
rendered="$(mktemp)"
trap 'rm -f "$rendered"' EXIT

tk show --dangerous-allow-redirect "$repo_root/tanka/environments/devops" \
  | yq -s '.' >"$rendered"

jq -e '
  (map(select(.kind == "ConfigMap" and .metadata.name == "canonical-gateway")) | first | .data.Caddyfile) as $caddy |
  (map(select(.kind == "ConfigMap" and .metadata.name == "coredns-custom")) | first | .data["kosmos.override"]) as $dns |
  ($caddy | contains("@meilisearch host meilisearch.localhost")) and
  ($caddy | contains("reverse_proxy meilisearch.meilisearch.svc.cluster.local:7700")) and
  ($dns | contains("rewrite name exact meilisearch.localhost canonical-gateway.devops.svc.cluster.local"))
' "$rendered" >/dev/null

printf 'canonical gateway routes the private Meilisearch host\n'
