#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

if rg -n 'services\.cloudflared\.tunnels\.kepos\.ingress\."ssh-wsl\.guion\.io"' \
  "${repo_root}/hosts/wsl/default.nix"; then
  echo "private WSL services remain exposed through the Kepos tunnel" >&2
  exit 1
fi

if rg -n 'services\.cloudflared\.tunnels\.kepos\.ingress' \
  "${repo_root}/modules/wsl/navidrome.nix" \
  "${repo_root}/modules/wsl/feishin-web.nix" \
  "${repo_root}/modules/wsl/listen-together.nix"; then
  echo "private WSL services remain exposed through the Kepos tunnel" >&2
  exit 1
fi

if rg -n '\$\{cfg\.(seafileHostname|onlyofficeHostname)\}.*=.*http://127\.0\.0\.1' \
  "${repo_root}/modules/wsl/seafarer-edge.nix"; then
  echo "private WSL services remain exposed through the Kepos tunnel" >&2
  exit 1
fi
