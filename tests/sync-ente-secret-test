#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" create namespace "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
elif [[ "$*" == *" get secret ente-stack-env "* && "$*" == *"jsonpath={.metadata.resourceVersion}"* ]]; then
  printf '73'
elif [[ "$*" == *" get deployment/museum "* || "$*" == *" get statefulset/postgres "* || "$*" == *" get statefulset/garage "* ]]; then
  exit 0
elif [[ "$*" == *" patch deployment/museum "* || "$*" == *" patch statefulset/postgres "* || "$*" == *" patch statefulset/garage "* ]]; then
  exit 0
elif [[ "$*" == *" rollout status "* ]]; then
  if [[ "$*" == *"$TEST_FAIL_ROLLOUT"* ]]; then
    exit 1
  fi
  exit 0
fi
EOF

sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

write_valid_env() {
  local destination="$1"
  printf '%s\n' \
    'POSTGRES_PASSWORD=test-postgres' \
    'ENTE_KEY_ENCRYPTION=test-encryption' \
    'ENTE_KEY_HASH=test-hash' \
    'ENTE_JWT_SECRET=test-jwt' \
    'GARAGE_RPC_SECRET=test-rpc' \
    'GARAGE_ACCESS_KEY=GKtest-access' \
    'GARAGE_SECRET_KEY=test-garage-secret' \
    >"$destination"
}

write_valid_env "$test_root/ente.env"
head -n 6 "$test_root/ente.env" >"$test_root/missing.env"
{
  cat "$test_root/ente.env"
  printf '%s\n' 'GARAGE_ACCESS_KEY=duplicate'
} >"$test_root/duplicate.env"
{
  cat "$test_root/ente.env"
  printf '%s\n' 'UNEXPECTED_KEY=value'
} >"$test_root/unknown.env"
sed 's/^ENTE_JWT_SECRET=.*/ENTE_JWT_SECRET=/' "$test_root/ente.env" >"$test_root/empty.env"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_FAIL_ROLLOUT="never-match"

for invalid_file in missing duplicate unknown empty; do
  : >"$TEST_KUBECTL_LOG"
  if bash "$repo_root/scripts/sync-ente-secret" "$test_root/$invalid_file.env" >"$test_root/$invalid_file-output" 2>&1; then
    echo "sync-ente-secret accepted $invalid_file input" >&2
    exit 1
  fi
  [[ ! -s "$TEST_KUBECTL_LOG" ]]
done
grep -q 'GARAGE_SECRET_KEY' "$test_root/missing-output"
grep -q 'GARAGE_ACCESS_KEY' "$test_root/duplicate-output"
grep -q 'UNEXPECTED_KEY' "$test_root/unknown-output"
grep -q 'ENTE_JWT_SECRET' "$test_root/empty-output"

: >"$TEST_KUBECTL_LOG"
bash "$repo_root/scripts/sync-ente-secret" --validate-only - \
  <"$test_root/ente.env" \
  >"$test_root/validate-output"
grep -q '^Ente environment validation passed$' "$test_root/validate-output"
[[ ! -s "$TEST_KUBECTL_LOG" ]]

bash "$repo_root/scripts/sync-ente-secret" "$test_root/ente.env"

awk '$1 != "--kubeconfig" || $2 != "/etc/rancher/k3s/k3s.yaml" { exit 1 }' "$TEST_KUBECTL_LOG"
grep -q 'create namespace photos --dry-run=client -o yaml' "$TEST_KUBECTL_LOG"
grep -q "create secret generic ente-stack-env --namespace photos --from-env-file=$test_root/ente.env --dry-run=client -o yaml" "$TEST_KUBECTL_LOG"
grep -q 'get secret ente-stack-env --namespace photos -o jsonpath={.metadata.resourceVersion}' "$TEST_KUBECTL_LOG"
for resource in deployment/museum statefulset/postgres statefulset/garage; do
  grep -q "patch $resource --namespace photos --type=merge" "$TEST_KUBECTL_LOG"
  grep -q "rollout status $resource --namespace photos --timeout=180s" "$TEST_KUBECTL_LOG"
done

: >"$TEST_KUBECTL_LOG"
export TEST_FAIL_ROLLOUT="statefulset/garage"
if bash "$repo_root/scripts/sync-ente-secret" "$test_root/ente.env" >"$test_root/rollout-output" 2>&1; then
  echo "sync-ente-secret ignored a failed rollout" >&2
  exit 1
fi
grep -q 'rollout did not complete for statefulset/garage' "$test_root/rollout-output"

: >"$TEST_KUBECTL_LOG"
export TEST_FAIL_ROLLOUT="never-match"
export TEST_KUBE_SERVER="https://kube-new.flicknote.app"
if bash "$repo_root/scripts/sync-ente-secret" "$test_root/ente.env" >"$test_root/remote-output" 2>&1; then
  echo "sync-ente-secret accepted a non-local cluster" >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://kube-new.flicknote.app' "$test_root/remote-output"
[[ "$(wc -l <"$TEST_KUBECTL_LOG")" -eq 1 ]]
