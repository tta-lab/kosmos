#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

python3 - "${repo_root}/modules/wsl/feishin-web.nix" <<'PY'
import pathlib
import re
import sys

module = pathlib.Path(sys.argv[1]).read_text()

if 'page-fallback =' in module:
    raise SystemExit('Feishin must return 404 for missing static assets')


def require_cache_header(source: str, value: str) -> None:
    pattern = re.compile(
        r'\[\[advanced\.headers\]\]\s*'
        rf'source = "{re.escape(source)}"\s*'
        r'\[advanced\.headers\.headers\]\s*'
        rf'Cache-Control = "{re.escape(value)}"'
    )
    if not pattern.search(module):
        raise SystemExit(f'missing Cache-Control for {source}: {value}')


for source in (
    '/index.html',
    '/settings.js',
    '/assets/sw.js',
    '/assets/manifest.webmanifest',
):
    require_cache_header(source, 'no-store')

require_cache_header(
    '/assets/*-*.{js,css,map,woff,woff2,png,svg,webp}',
    'public, max-age=31536000, immutable',
)
PY
