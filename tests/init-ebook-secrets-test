#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin"

cat >"$test_root/bin/kubectl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_KUBECTL_LOG"

if [[ "$*" == *" config view "* ]]; then
  printf '%s' "$TEST_KUBE_SERVER"
elif [[ "$*" == *" get secret booklore-env "* ]]; then
  [[ "$TEST_EXISTING_SECRETS" == *booklore* ]]
elif [[ "$*" == *" get secret bookorbit-env "* ]]; then
  [[ "$TEST_EXISTING_SECRETS" == *bookorbit* ]]
elif [[ "$*" == *" create namespace ebooks "* ]]; then
  printf '%s\n' 'apiVersion: v1' 'kind: Namespace'
elif [[ "$*" == *" create secret generic "* ]]; then
  [[ "$*" != *"--from-literal"* ]]
  [[ "$*" == *"--from-env-file="* ]]
  printf '%s\n' 'apiVersion: v1' 'kind: Secret'
elif [[ "$*" == *" apply -f -"* ]]; then
  manifest="$(cat)"
  [[ "$manifest" == *"apiVersion: v1"* ]]
fi
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/kubectl"
chmod +x "$test_root/bin/kubectl"

cat >"$test_root/bin/openssl" <<'EOF'
#!@bash@
set -euo pipefail
printf '%s\n' "$*" >>"$TEST_OPENSSL_LOG"
printf 'generated-secret-value'
EOF
sed -i "s|@bash@|$BASH|" "$test_root/bin/openssl"
chmod +x "$test_root/bin/openssl"

export PATH="$test_root/bin:$PATH"
export TEST_KUBECTL_LOG="$test_root/kubectl.log"
export TEST_OPENSSL_LOG="$test_root/openssl.log"
export TEST_KUBE_SERVER="https://127.0.0.1:26443"
export TEST_EXISTING_SECRETS=""

bash "$repo_root/scripts/init-ebook-secrets" >"$test_root/first-output"
grep -q '^Created BookLore credentials$' "$test_root/first-output"
grep -q '^Created BookOrbit credentials$' "$test_root/first-output"
grep -q 'create secret generic booklore-env --namespace ebooks --from-env-file=' "$TEST_KUBECTL_LOG"
grep -q 'create secret generic bookorbit-env --namespace ebooks --from-env-file=' "$TEST_KUBECTL_LOG"
[[ "$(wc -l <"$TEST_OPENSSL_LOG")" -eq 5 ]]
if grep -q 'generated-secret-value' "$test_root/first-output"; then
  echo 'init-ebook-secrets printed a generated value' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_EXISTING_SECRETS="booklore bookorbit"
bash "$repo_root/scripts/init-ebook-secrets" >"$test_root/existing-output"
grep -q '^Kept existing BookLore credentials$' "$test_root/existing-output"
grep -q '^Kept existing BookOrbit credentials$' "$test_root/existing-output"
[[ ! -s "$TEST_OPENSSL_LOG" ]]
if grep -q 'create secret generic' "$TEST_KUBECTL_LOG"; then
  echo 'init-ebook-secrets replaced an existing Secret' >&2
  exit 1
fi

: >"$TEST_KUBECTL_LOG"
: >"$TEST_OPENSSL_LOG"
export TEST_EXISTING_SECRETS=""
export TEST_KUBE_SERVER="https://remote.example.invalid"
if bash "$repo_root/scripts/init-ebook-secrets" >"$test_root/remote-output" 2>&1; then
  echo 'init-ebook-secrets accepted a non-local cluster' >&2
  exit 1
fi
grep -q 'refusing non-local cluster: https://remote.example.invalid' "$test_root/remote-output"
[[ ! -s "$TEST_OPENSSL_LOG" ]]

printf 'ebook Secret initialization is local-only, idempotent, and does not expose generated values\n'
