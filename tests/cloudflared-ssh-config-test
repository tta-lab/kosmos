#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
expected='services.cloudflared.tunnels.kepos.ingress."ssh-wsl.guion.io" = "ssh://127.0.0.1:22";'

if grep -Fqx "  $expected" "${repo_root}/hosts/wsl/default.nix"; then
  exit 0
fi

printf 'missing Cloudflare SSH ingress: %s\n' "$expected" >&2
exit 1
