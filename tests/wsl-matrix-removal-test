#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

test -f "${repo_root}/modules/wsl/kepos-tunnel.nix"
test ! -e "${repo_root}/modules/wsl/kepos-matrix.nix"

if rg -n 'keposMatrix|matrix-tuwunel|tuwunel-registration|kepos\.guion\.io' \
  "${repo_root}/modules" \
  "${repo_root}/hosts" \
  "${repo_root}/secrets.nix"; then
  echo "Matrix configuration remains in the WSL system" >&2
  exit 1
fi

rg -q 'keposTunnel\.enable = true;' "${repo_root}/hosts/wsl/default.nix"
rg -q 'cloudflared-kepos-credentials' "${repo_root}/modules/wsl/kepos-tunnel.nix"
rg -q 'tunnels\.kepos' "${repo_root}/modules/wsl/kepos-tunnel.nix"
