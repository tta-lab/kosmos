#!/usr/bin/env bash
set -euo pipefail

repo_root="${KOSMOS_REPO_ROOT:-$(pwd)}"

bash "${repo_root}/scripts/forgejo-restore-smoke" --help 2>&1 | grep -q 'usage: forgejo-restore-smoke'
bash "${repo_root}/scripts/forgejo-restore-smoke" --help 2>&1 | grep -q -- '--known-user <name>'
bash "${repo_root}/scripts/forgejo-restore-smoke" --help 2>&1 | grep -q -- '--known-org <name>'
bash "${repo_root}/scripts/forgejo-restore-smoke" --help 2>&1 | grep -q -- '--clone-repo <owner/repo>'
bash "${repo_root}/scripts/forgejo-restore-smoke" --help 2>&1 | grep -q -- '--require-package-data'
grep -q 'RUN_USER' "${repo_root}/scripts/forgejo-restore-smoke"
grep -q 'verify_known_user' "${repo_root}/scripts/forgejo-restore-smoke"
grep -q 'verify_known_org' "${repo_root}/scripts/forgejo-restore-smoke"
grep -q 'verify_clone_repo' "${repo_root}/scripts/forgejo-restore-smoke"
grep -q 'verify_package_data' "${repo_root}/scripts/forgejo-restore-smoke"
